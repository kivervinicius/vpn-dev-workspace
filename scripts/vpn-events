#!/usr/bin/env node
const path=require("node:path");
const mod=process.env.VPN_CONTROL_MODULE_DIR || path.resolve(__dirname,"../apps/control-plane/lib");
require(path.join(mod,"events.cjs")).main(process.argv.slice(2)).catch(()=>{process.stderr.write("vpn-events: operation failed\n");process.exitCode=1});
