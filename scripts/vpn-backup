#!/usr/bin/env node
const path=require("node:path");
const mod=process.env.VPN_CONTROL_MODULE_DIR || path.resolve(__dirname,"../apps/control-plane/lib");
require(path.join(mod,"backup.cjs")).main(process.argv.slice(2)).catch(e=>{process.stderr.write("vpn-backup: "+e.message+"\n");process.exitCode=1});
