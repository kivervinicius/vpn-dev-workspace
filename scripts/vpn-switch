#!/usr/bin/env bash
set -Eeuo pipefail

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly COMPOSE_FILE="${ROOT_DIR}/docker-compose.yml"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Uso: vpn-switch <perfil> [--help]" >&2
  echo "Perfis: nordvpn-openvpn|nordvpn-wireguard|protonvpn-openvpn|protonvpn-wireguard|surfshark-openvpn|mullvad-wireguard|custom-openvpn|custom-wireguard" >&2
  echo "Valida, sobe o perfil (rebuild), aguarda health, aplica LOCAL_HOSTS." >&2
  exit 0
fi

trap 'echo "vpn-switch: interrompido pelo usuário." >&2; exit 130' INT

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }
}

need docker
need awk

read_compose_value() {
  local name="$1" default_value="$2" value=""

  if [[ -n "${!name+x}" ]]; then
    printf '%s\n' "${!name}"
    return
  fi

  if [[ -f "${ROOT_DIR}/.env" ]]; then
    value="$(awk -v prefix="${name}=" 'index($0, prefix) == 1 { print substr($0, length(prefix) + 1); exit }' "${ROOT_DIR}/.env")"
  fi

  printf '%s\n' "${value:-$default_value}"
}

port_is_published_by_current_project() {
  local port="$1" container_id ps_output
  local project_name="${COMPOSE_PROJECT_NAME:-$(basename "$ROOT_DIR")}"

  if ! ps_output="$(docker ps -q --filter "label=com.docker.compose.project=${project_name}" 2>/dev/null)"; then
    echo "Aviso: não foi possível listar contêineres do Docker; assumindo portas livres." >&2
    return 1
  fi
  while IFS= read -r container_id; do
    [[ -n "$container_id" ]] || continue
    docker port "$container_id" 2>/dev/null | grep -Eq ":${port}$" && return 0
  done <<< "$ps_output"

  return 1
}

validate_port_range() {
  local port_range="$1" start_port end_port port
  local -a conflicts=()

  if [[ "$port_range" =~ ^([1-9][0-9]{0,4})-([1-9][0-9]{0,4})$ ]]; then
    start_port="${BASH_REMATCH[1]}"
    end_port="${BASH_REMATCH[2]}"
  elif [[ "$port_range" =~ ^[1-9][0-9]{0,4}$ ]]; then
    start_port="$port_range"
    end_port="$port_range"
  else
    echo "Erro: VPN_PORT_RANGE deve ser uma porta ou faixa, por exemplo 10000-10100." >&2
    exit 2
  fi

  if (( start_port > end_port || end_port > 65535 )); then
    echo "Erro: VPN_PORT_RANGE está fora do intervalo válido de portas." >&2
    exit 2
  fi

  need ss
  for ((port = start_port; port <= end_port; port++)); do
    if ss -H -ltn "sport = :${port}" | grep -q . && ! port_is_published_by_current_project "$port"; then
      conflicts+=("$port")
    fi
  done

  if ((${#conflicts[@]} > 0)); then
    echo "Erro: portas ocupadas no host: ${conflicts[*]}. Escolha outra VPN_PORT_RANGE." >&2
    exit 1
  fi
}

usage() {
  echo "Uso: vpn-switch <nordvpn-openvpn|nordvpn-wireguard|protonvpn-openvpn|protonvpn-wireguard|surfshark-openvpn|mullvad-wireguard|custom-openvpn|custom-wireguard>" >&2
  exit 2
}

profile="${1:-}"
[[ -n "$profile" ]] || usage

case "$profile" in
  nordvpn-openvpn|nordvpn-wireguard|protonvpn-openvpn|protonvpn-wireguard|surfshark-openvpn|mullvad-wireguard|custom-openvpn|custom-wireguard) ;;
  *) echo "Erro: perfil não permitido: $profile" >&2; usage ;;
esac

readonly PROFILE_FILE="${ROOT_DIR}/profiles/${profile}.yml"
[[ -f "$PROFILE_FILE" ]] || { echo "Erro: perfil ausente: $PROFILE_FILE" >&2; exit 1; }

# Hosts locais (opt-in): valida LOCAL_HOSTS e gera o snippet aplicado pós-up.
# Sem LOCAL_HOSTS, o generator remove o snippet e nada muda.
"${ROOT_DIR}/scripts/vpn-hosts-gen"

compose=(docker compose --profile vpn -f "$COMPOSE_FILE" -f "$PROFILE_FILE")
echo "Validando perfil ${profile}..."
"${compose[@]}" config --quiet

host_bind_address="$(read_compose_value HOST_BIND_ADDRESS 127.0.0.1)"
[[ "$host_bind_address" != "0.0.0.0" && "$host_bind_address" != "::" ]] || {
  echo "Erro: use o IP específico da interface LAN em HOST_BIND_ADDRESS, não um bind público." >&2
  exit 2
}
port_range="$(read_compose_value VPN_PORT_RANGE 10000-10100)"
validate_port_range "$port_range"

# Proxy HTTP opt-in: a porta precisa estar na faixa publicada pelo Gluetun.
http_proxy="$(read_compose_value VPN_HTTP_PROXY off)"
if [[ "${http_proxy,,}" == "on" ]]; then
  http_port="$(read_compose_value VPN_HTTP_PROXY_PORT 10080)"
  [[ "$http_port" =~ ^[1-9][0-9]{0,4}$ && "$http_port" -le 65535 ]] || {
    echo "Erro: VPN_HTTP_PROXY_PORT inválida: $http_port." >&2
    exit 2
  }
  if [[ "$port_range" =~ ^([1-9][0-9]{0,4})-([1-9][0-9]{0,4})$ ]]; then
    (( http_port < BASH_REMATCH[1] || http_port > BASH_REMATCH[2] )) && {
      echo "Erro: VPN_HTTP_PROXY_PORT (${http_port}) fora de VPN_PORT_RANGE (${port_range})." >&2
      exit 2
    }
  elif [[ "$http_port" != "$port_range" ]]; then
    echo "Erro: VPN_HTTP_PROXY_PORT (${http_port}) fora de VPN_PORT_RANGE (${port_range})." >&2
    exit 2
  fi
  echo "Proxy HTTP pela VPN em http://127.0.0.1:${http_port} (dentro da faixa publicada)."
fi

# Acesso à rede interna do host (opt-in): quando FIREWALL_SUBNETS não está
# definido no ambiente nem no .env, injeta a sub-rede da interface que possui a
# rota padrão do host (a LAN local). Extras/config explícitos continuam válidos.
firewall_subnets="$(read_compose_value FIREWALL_SUBNETS "")"
if [[ -z "$firewall_subnets" ]]; then
  need ip
  lan_interface="$(ip route show default 2>/dev/null | awk '/^default/ {print $5; exit}')"
  if [[ -n "$lan_interface" ]]; then
    lan_subnet="$(ip -o -4 addr show dev "$lan_interface" 2>/dev/null | awk '{print $4; exit}')"
  fi
  if [[ -n "${lan_subnet:-}" ]]; then
    export FIREWALL_SUBNETS="$lan_subnet"
    echo "Rede interna liberada no firewall: ${lan_subnet} (interface ${lan_interface})."
  else
    echo "Aviso: não foi possível detectar a sub-rede da LAN; rede interna bloqueada." >&2
  fi
fi

# DNS interno: o Gluetun só obedece a DNS_UPSTREAM_PLAIN_ADDRESSES com
# DNS_UPSTREAM_RESOLVER_TYPE=plain (sem isso ele ignora e usa DoT/Cloudflare).
# Vazio aqui é significativo: distingue "não definido" (default cloudflare)
# de "vazio de propósito" (upstream plain único).
internal_dns="$(read_compose_value INTERNAL_DNS "")"
internal_dns_resolvers_isset=false
internal_dns_resolvers=""
if [[ -n "${INTERNAL_DNS_RESOLVERS+x}" ]]; then
  internal_dns_resolvers_isset=true
  internal_dns_resolvers="$INTERNAL_DNS_RESOLVERS"
elif [[ -f "${ROOT_DIR}/.env" ]] && grep -Eq '^[[:space:]]*INTERNAL_DNS_RESOLVERS=' "${ROOT_DIR}/.env"; then
  internal_dns_resolvers_isset=true
  internal_dns_resolvers="$(awk -v prefix="INTERNAL_DNS_RESOLVERS=" 'index($0, prefix) == 1 { print substr($0, length(prefix) + 1); exit }' "${ROOT_DIR}/.env")"
fi
if [[ -n "$internal_dns" ]]; then
  export DNS_UPSTREAM_RESOLVER_TYPE=plain
  echo "DNS interno ativo (${internal_dns}); upstream plain único."
  if $internal_dns_resolvers_isset && [[ -n "$internal_dns_resolvers" ]]; then
    echo "Aviso: INTERNAL_DNS ativo com INTERNAL_DNS_RESOLVERS=${internal_dns_resolvers} (ignorado em modo plain, mas deixe vazio no .env)." >&2
  fi
fi

echo "Parando o perfil atual..."
"${compose[@]}" down --remove-orphans
echo "Subindo o perfil ${profile}..."
"${compose[@]}" up -d --build --remove-orphans

vpn_container="$("${compose[@]}" ps -q vpn)"
[[ -n "$vpn_container" ]] || {
  echo "Erro: o contêiner VPN não foi criado." >&2
  "${compose[@]}" logs --tail=80 vpn >&2 || true
  exit 1
}

for _ in {1..60}; do
  health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}starting{{end}}' "$vpn_container" 2>/dev/null || true)"
  case "$health" in
    healthy)
      echo "Perfil ${profile} conectado."
      "${ROOT_DIR}/scripts/vpn-hosts-apply"
      exit 0
      ;;
    unhealthy) echo "Erro: o perfil ${profile} falhou no healthcheck." >&2; "${compose[@]}" logs --tail=80 vpn >&2; exit 1 ;;
  esac
  sleep 2
done

echo "Erro: tempo limite aguardando o healthcheck do perfil ${profile}." >&2
"${compose[@]}" logs --tail=80 vpn >&2
exit 1
