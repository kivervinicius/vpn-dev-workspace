#!/usr/bin/env bash
set -Eeuo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/vpn-control-api.sh"

readonly API_URL="${GLUETUN_API_URL:-$(vpn_control_default_url)}"
readonly API_KEY_FILE="${GLUETUN_API_KEY_FILE:-$(vpn_control_default_key_file "$(dirname "${BASH_SOURCE[0]}")")}"
readonly CURL_TIMEOUT_ARGS=(--connect-timeout 5 --max-time 10)

usage() {
  echo "Uso: vpn-server-rotate [--to <host>|--random|--countries <lista>|--list] [--api-url <url>]" >&2
  echo "  (sem flags) round-robin em VPN_SERVER_HOSTNAMES ou re-seleção aleatória" >&2
  echo "  --to        salta direto para o host (deve estar na lista)" >&2
  echo "  --random    escolhe um servidor aleatório DIFERENTE do atual (usa a lista" >&2
  echo "              quando existir; sem lista, re-seleciona no país configurado)" >&2
  echo "  --countries lista de países separada por vírgula (ex: Brazil,Argentina,Chile);" >&2
  echo "              limpa os hostnames e deixa o Gluetun escolher em qualquer um deles" >&2
  echo "  --list      mostra a lista e o índice atual" >&2
  echo "Falha na troca ou túnel insaudável após a troca restaura o servidor anterior." >&2
  echo "Exit 3 = lista sem alternativa; exit 4 = revert falhou (exige intervenção)." >&2
  exit 0
}

want_to=""
want_random=false
want_list=false
want_countries_raw=""
api_url="$API_URL"
while (($# > 0)); do
  case "$1" in
    --to) want_to="${2:-}"; [[ -n "$want_to" ]] || { echo "Erro: --to exige um hostname." >&2; exit 2; }; shift 2 ;;
    --random) want_random=true; shift ;;
    --countries) want_countries_raw="${2:-}"; [[ -n "$want_countries_raw" ]] || { echo "Erro: --countries exige uma lista de países." >&2; exit 2; }; shift 2 ;;
    --list) want_list=true; shift ;;
    --api-url) api_url="${2:-}"; [[ -n "$api_url" ]] || { echo "Erro: --api-url exige um valor." >&2; exit 2; }; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Erro: argumento desconhecido: $1" >&2; exit 2 ;;
  esac
done

if [[ -n "$want_to" && -n "$want_countries_raw" ]]; then
  echo "Erro: --to e --countries são mutuamente exclusivos." >&2
  exit 2
fi

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }
}

resolve_helper() {
  if command -v "$1" >/dev/null 2>&1; then
    command -v "$1"
  elif [[ -x "/usr/local/bin/$1" ]]; then
    printf '/usr/local/bin/%s' "$1"
  else
    return 1
  fi
}

api_request() {
  vpn_api_curl --fail --silent --show-error --retry 3 --retry-all-errors \
    "${CURL_TIMEOUT_ARGS[@]}" \
    "$@"
}

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

source "$(dirname "${BASH_SOURCE[0]}")/vpn-control-lock.sh"
readonly STATE_FILE="${VPN_ROTATE_STATE_FILE:-$(vpn_control_state_file vpn-rotate.index)}"

hostnames_raw="${VPN_SERVER_HOSTNAMES:-}"
hostnames_env=()
if [[ -n "$hostnames_raw" ]]; then
  IFS=',' read -r -a _split <<< "$hostnames_raw" || true
  for _h in "${_split[@]:-}"; do
    _h="$(trim "$_h")"
    [[ -n "$_h" ]] && hostnames_env+=("$_h")
  done
  unset _split _h
fi

countries_req=()
if [[ -n "$want_countries_raw" ]]; then
  IFS=',' read -r -a _split_countries <<< "$want_countries_raw" || true
  for _c in "${_split_countries[@]:-}"; do
    _c="$(trim "$_c")"
    [[ -n "$_c" ]] && countries_req+=("$_c")
  done
  unset _split_countries _c
  ((${#countries_req[@]} > 0)) || { echo "Erro: --countries sem países válidos." >&2; exit 2; }
fi

if ((${#countries_req[@]} > 0)) && ((${#hostnames_env[@]} > 0)); then
  echo "Aviso: VPN_SERVER_HOSTNAMES está definido; --countries vale só até o próximo restart e pode escolher servidores inalcançáveis. Para persistir, limpe VPN_SERVER_HOSTNAMES no .env." >&2
fi

if [[ -n "$want_to" ]] && ((${#hostnames_env[@]} == 0)); then
  echo "Erro: --to exige VPN_SERVER_HOSTNAMES preenchido." >&2
  exit 2
fi
if $want_list; then
  if ((${#hostnames_env[@]} > 0)); then
    current=""
    if [[ -f "$STATE_FILE" ]] && [[ "$(<"$STATE_FILE")" =~ ^[0-9]+$ ]]; then
      current="$(<"$STATE_FILE")"
    fi
    for i in "${!hostnames_env[@]}"; do
      if [[ "$current" == "$i" ]]; then
        printf '* %s (atual)\n' "${hostnames_env[$i]}"
      else
        printf '  %s\n' "${hostnames_env[$i]}"
      fi
    done
  else
    echo "Sem VPN_SERVER_HOSTNAMES (re-seleção aleatória no país configurado)."
  fi
  if ((${#countries_req[@]} > 0)); then
    printf 'Países solicitados: %s\n' "$(IFS=', '; echo "${countries_req[*]}")"
  fi
  exit 0
fi

need curl
need jq
[[ -r "$API_KEY_FILE" ]] || { echo "Erro: segredo da API ausente: $API_KEY_FILE" >&2; exit 1; }

vpn_control_lock_acquire || {
  lock_rc=$?
  if ((lock_rc == 75)); then
    echo "VPN já está sendo alterada; tente novamente no próximo ciclo." >&2
    exit 75
  fi
  echo "Erro: não foi possível adquirir o lock de controle VPN." >&2
  exit 1
}

settings="$(api_request "${api_url}/v1/vpn/settings")"
countries="$(printf '%s' "$settings" | jq -c '.provider.server_selection.countries // []' 2>/dev/null || printf '[]')"
# Snapshot do servidor atual para restaurar em caso de falha (revert).
before_selection="$(printf '%s' "$settings" | jq -c '.provider.server_selection | {hostnames: (.hostnames // []), countries: (.countries // [])}' 2>/dev/null || printf '{"hostnames":[],"countries":[]}')"

write_state_index() {
  local index="$1" state_tmp
  mkdir -p "$(dirname "$STATE_FILE")" || { echo "Erro: não foi possível atualizar índice da rotação." >&2; return 1; }
  state_tmp="$(mktemp "${STATE_FILE}.XXXXXX")" || { echo "Erro: não foi possível atualizar índice da rotação." >&2; return 1; }
  if ! printf '%s\n' "$index" > "$state_tmp" || ! mv -f "$state_tmp" "$STATE_FILE"; then
    rm -f "$state_tmp"
    echo "Erro: não foi possível atualizar índice da rotação." >&2
    return 1
  fi
}

restore_selection() {
  local restore_patch
  restore_patch="$(jq -nc --argjson sel "$before_selection" '{provider:{server_selection:$sel}}')" || return 1
  echo "Revertendo para o servidor anterior..." >&2
  if ! api_request -X PUT -H "Content-Type: application/json" -d "$restore_patch" "${api_url}/v1/vpn/settings" >/dev/null 2>&1; then
    echo "Erro: revert falhou; restaure manualmente ${before_selection}." >&2
    exit 4
  fi
  echo "Servidor anterior restaurado na configuração." >&2
  if helper="$(resolve_helper vpn-reconnect)"; then
    if ! GLUETUN_API_URL="$api_url" "$helper" >/dev/null 2>&1; then
      echo "Erro: reconexão após o revert falhou; restaure e verifique ${before_selection}." >&2
      exit 4
    fi
    echo "Túnel reconectado após o revert." >&2
  fi
}

patch=""
next_index=""
if ((${#countries_req[@]} > 0)); then
  countries_json="$(jq -nc --args '$ARGS.positional' "${countries_req[@]}")"
  patch="$(jq -nc --argjson countries "$countries_json" '{provider:{server_selection:{hostnames:[],countries:$countries}}}')"
  echo "Selecionando país(es): ${countries_req[*]}"
elif ((${#hostnames_env[@]} > 0)); then
  total="${#hostnames_env[@]}"
  if ((total == 1)) && [[ -z "$want_to" ]] && ! $want_random; then
    # rc 3 = no-op: o túnel NÃO foi alterado. rc 0 significaria "rotacionado e
    # saudável" e faria o auto-reconnect declarar saúde falsa (túnel morto).
    echo "Aviso: lista com 1 servidor (${hostnames_env[0]}); nada a rotacionar." >&2
    exit 3
  fi
  if [[ -n "$want_to" ]]; then
    to_index=-1
    for i in "${!hostnames_env[@]}"; do
      [[ "${hostnames_env[$i]}" == "$want_to" ]] && to_index="$i" && break
    done
    ((to_index >= 0)) || { echo "Erro: '${want_to}' fora de VPN_SERVER_HOSTNAMES." >&2; exit 2; }
    next_index="$to_index"
  else
    previous=-1
    if [[ -f "$STATE_FILE" ]] && [[ "$(<"$STATE_FILE")" =~ ^[0-9]+$ ]]; then
      previous="$(<"$STATE_FILE")"
    fi
    if $want_random; then
      # Aleatório DENTRO da lista: preserva a lista curada no Gluetun (antes,
      # --random limpava os hostnames do runtime até o próximo recreate).
      if ((total == 1)); then
        next_index=0
      else
        next_index="$(( RANDOM % total ))"
        if ((total > 1)); then
          while ((next_index == previous)); do
            next_index="$(( RANDOM % total ))"
          done
        fi
      fi
      echo "Re-seleção aleatória dentro da lista configurada."
    else
      if ((previous < 0)); then
        previous=$((total - 1))
      fi
      next_index=$(( (previous + 1) % total ))
    fi
  fi
  target="${hostnames_env[$next_index]}"
  patch="$(jq -nc --arg hostname "$target" '{provider:{server_selection:{hostnames:[$hostname]}}}')"
  echo "Rotacionando para o servidor: ${target}"
else
  country_hint="país configurado"
  [[ "$countries" == "[]" ]] && country_hint="qualquer país"
  patch="$(jq -nc --argjson countries "$countries" '{provider:{server_selection:{hostnames:[],countries:$countries}}}')"
  echo "Re-selecionando um servidor aleatório (${country_hint})."
fi

echo "Aplicando troca de servidor no Gluetun..."
if ! outcome="$(api_request -X PUT -H "Content-Type: application/json" -d "$patch" "${api_url}/v1/vpn/settings")"; then
  echo "Erro: o Gluetun não aceitou a troca de servidor." >&2
  restore_selection
  exit 1
fi
echo "Resposta do Gluetun: ${outcome}"

# O Gluetun reinicia o túnel ao aplicar as configurações; aguarda o IP novo.
echo "Aguardando IP público após a troca..."
reconnect_bin="$(resolve_helper vpn-reconnect)" || {
  echo "Erro: helper ausente: vpn-reconnect." >&2
  restore_selection
  exit 1
}
if ! new_ip="$(GLUETUN_API_URL="$api_url" "$reconnect_bin")"; then
  echo "Erro: reconexão após a troca de servidor falhou." >&2
  restore_selection
  exit 1
fi
echo "IP público após a troca: ${new_ip:-desconhecido}"

# A rotação só é bem-sucedida com o túnel saudável no novo servidor.
if check_bin="$(resolve_helper vpn-check)"; then
  if ! "$check_bin" --only tunnel -q >/dev/null 2>&1; then
    echo "Erro: túnel insaudável após a troca de servidor." >&2
    restore_selection
    exit 1
  fi
  echo "Túnel saudável no novo servidor."
else
  echo "Aviso: vpn-check indisponível; saúde do túnel não foi verificada." >&2
fi

# Índice só após sucesso: rotação falha/revertida não pode avançar o round-robin.
if [[ -n "$next_index" ]]; then
  if ! write_state_index "$next_index"; then
    echo "Erro: índice da rotação não foi gravado; revertendo seleção." >&2
    restore_selection
    exit 1
  fi
fi
