#!/usr/bin/env bash
# vpn-opencode: painel web/serve do OpenCode executado DENTRO do túnel VPN.
# Rode no host; o tráfego de agentes/LLM sai 100% pela VPN. Acesso no host em
# http://127.0.0.1:<porta> (na faixa publicada pelo Gluetun).
set -Eeuo pipefail

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }
}

need docker

usage() {
  echo "Uso: vpn-opencode <web|serve> [porta]" >&2
  echo "  web    abre o painel web no navegador do host (padrão)." >&2
  echo "  serve  expõe a ponta para o Desktop App do OpenCode." >&2
  echo "Porta padrão: \${OPENCODE_GUI_PORT:-10001} (deve estar na VPN_PORT_RANGE)." >&2
  exit 2
}

mode="${1:-}"
[[ -n "$mode" ]] || usage
case "$mode" in
  web|serve) ;;
  *) usage ;;
esac

port="${2:-${OPENCODE_GUI_PORT:-10001}}"
[[ "$port" =~ ^[1-9][0-9]{0,4}$ && "$port" -le 65535 ]] || { echo "Erro: porta inválida: $port (1-65535)" >&2; exit 2; }

compose=(docker compose --profile vpn -f "${ROOT_DIR}/docker-compose.yml")

vpn_container="$("${compose[@]}" ps -q vpn 2>/dev/null || true)"
[[ -n "$vpn_container" ]] || { echo "Erro: VPN não está ativa; inicie com ./scripts/vpn-switch <perfil>." >&2; exit 1; }

vpn_healthy="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}starting{{end}}' "$vpn_container" 2>/dev/null || true)"
[[ "$vpn_healthy" == "healthy" ]] || { echo "Erro: VPN ainda não está saudável (status: ${vpn_healthy})." >&2; exit 1; }

password_file="${OPENCODE_GUI_PASSWORD_FILE:-${ROOT_DIR}/.secrets/opencode_gui_password}"
if [[ "$password_file" != /* ]]; then
  password_file="${ROOT_DIR}/${password_file}"
fi
if [[ -r "$password_file" ]]; then
  export OPENCODE_SERVER_PASSWORD="$(tr -d '\r\n' < "$password_file")"
  export OPENCODE_SERVER_USER="${OPENCODE_SERVER_USER:-opencode}"
else
  echo "Aviso: sem arquivo de senha em ${password_file}; o painel abre sem autenticação (apenas local)." >&2
fi

echo "OpenCode ${mode} pela VPN em http://127.0.0.1:${port} (Ctrl+C para encerrar)..."
# Sem navegador no container: o xdg-open falha no stderr (ruído cosmético) e o
# servidor continua de pé; o acesso é pelo navegador do próprio host.
env_args=()
if [[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]]; then env_args+=(-e OPENCODE_SERVER_PASSWORD); fi
if [[ -n "${OPENCODE_SERVER_USER:-}" ]]; then env_args+=(-e OPENCODE_SERVER_USER); fi
exec docker compose --profile vpn -f "${ROOT_DIR}/docker-compose.yml" exec \
  "${env_args[@]}" \
  terminal opencode "$mode" --port "$port" --hostname 0.0.0.0