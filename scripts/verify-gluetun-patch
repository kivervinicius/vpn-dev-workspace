#!/usr/bin/env bash
# verify-gluetun-patch: confere se um patch local aplica limpo no upstream.
#
# Uso: verify-gluetun-patch [--tag <tag>] [--patch <arquivo>]
#
# Padrão: tag v3.41.4-rc2 e patch gluetun/publicip-recovery-rc2.patch
# (preparação sem cutover: o runtime segue em v3.41.3).
set -Eeuo pipefail

ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TAG="v3.41.4-rc2"
PATCH_FILE="${ROOT_DIR}/gluetun/publicip-recovery-rc2.patch"
UPSTREAM_REPO="qdm12/gluetun"

usage() {
  echo "Uso: verify-gluetun-patch [--tag <tag>] [--patch <arquivo>]" >&2
  echo "  --tag    tag upstream a conferir (padrão: ${TAG})" >&2
  echo "  --patch  patch local (padrão: gluetun/publicip-recovery-rc2.patch)" >&2
  exit 0
}

while (($# > 0)); do
  case "$1" in
    --tag) TAG="${2:-}"; [[ -n "$TAG" ]] || { echo "Erro: --tag exige valor." >&2; exit 2; }; shift 2 ;;
    --patch) PATCH_FILE="${2:-}"; [[ -n "$PATCH_FILE" ]] || { echo "Erro: --patch exige valor." >&2; exit 2; }; shift 2 ;;
    -h|--help) usage ;;
    *) echo "Erro: argumento desconhecido: $1" >&2; exit 2 ;;
  esac
done

[[ -f "$PATCH_FILE" ]] || { echo "Erro: patch ausente: ${PATCH_FILE}" >&2; exit 2; }
command -v curl >/dev/null 2>&1 || { echo "Erro: dependência ausente: curl" >&2; exit 2; }
command -v patch >/dev/null 2>&1 || { echo "Erro: dependência ausente: patch" >&2; exit 2; }

workdir="$(mktemp -d "${TMPDIR:-/tmp}/gluetun-patch.XXXXXX")"
trap 'rm -rf "$workdir"' EXIT

tarball="${workdir}/source.tar.gz"
if ! curl -fsSL --retry 2 --max-time 120 \
  "https://github.com/${UPSTREAM_REPO}/archive/refs/tags/${TAG}.tar.gz" -o "$tarball"; then
  echo "Erro: não foi possível baixar ${UPSTREAM_REPO}@${TAG} (rede indisponível)." >&2
  exit 2
fi

tar -xzf "$tarball" -C "$workdir"
source_dir="$(find "$workdir" -mindepth 1 -maxdepth 1 -type d | head -n 1)"
[[ -n "$source_dir" ]] || { echo "Erro: fonte extraída vazia." >&2; exit 1; }

if patch -p1 --dry-run --forward -d "$source_dir" < "$PATCH_FILE"; then
  echo "Patch aplica limpo em ${UPSTREAM_REPO}@${TAG}: $(basename "$PATCH_FILE")"
  exit 0
fi

echo "Erro: patch não aplica limpo em ${UPSTREAM_REPO}@${TAG}." >&2
exit 1
