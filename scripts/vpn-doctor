#!/usr/bin/env bash
# vpn-doctor: diagnóstico unificado do ambiente VPN executado no host.
# Inspeciona Docker, contêineres, segredos locais, saúde do túnel e OpenCode.
set -Eeuo pipefail

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly SECRETS_DIR="${ROOT_DIR}/.secrets"

usage() {
  cat >&2 <<'EOF'
Uso: vpn-doctor [--json] [--fix] [--no-color] [--bundle <arquivo>] [--redact-ips] [--help]

Opções:
  --json      Emite diagnóstico consolidado em formato JSON
  --fix       Aplica correções automáticas seguras (ex: chmod 600 .secrets/*)
  --no-color  Desativa cores ANSI na saída de texto
  --bundle    Gera um .tar.gz sanitizado de diagnóstico no caminho informado
  --redact-ips  Substitui IPs (v4/v6) por <ip-redigido> no bundle
  -h, --help  Exibe esta ajuda

Verificações executadas:
  1. Dependências do host (docker, curl, jq, awk)
  2. Estado do daemon Docker
  3. Integridade e permissões de segredos (.secrets/ em modo 0600)
  4. Saúde dos serviços Docker Compose (vpn, terminal, auto-reconnect, supervisor)
  5. Diagnóstico de túnel e DNS executado pelo vpn-check interno
  6. Disponibilidade da interface OpenCode (quando em execução)

Conteúdo do bundle (allowlist; nunca inclui .secrets/, auth.json, bancos de
sessão nem valores do .env):
  manifest.txt, doctor.tsv, doctor.json, environment.txt, env-keys.txt,
  compose-ps.txt, vpn-check.json, logs-vpn.txt, logs-terminal.txt
EOF
  exit 0
}

output_json=false
auto_fix=false
no_color=false
redact_ips=false
bundle_path=""

while (($# > 0)); do
  case "$1" in
    --json) output_json=true; shift ;;
    --fix) auto_fix=true; shift ;;
    --no-color) no_color=true; shift ;;
    --redact-ips) redact_ips=true; shift ;;
    --bundle)
      [[ $# -ge 2 ]] || { echo "Erro: --bundle exige um caminho de arquivo." >&2; exit 2; }
      bundle_path="$2"
      shift 2
      ;;
    -h|--help) usage ;;
    *) echo "Erro: argumento desconhecido: $1" >&2; exit 2 ;;
  esac
done

if [[ -t 1 && "$no_color" != true ]]; then
  readonly C_BOLD=$'\033[1m'
  readonly C_GREEN=$'\033[32m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_RED=$'\033[31m'
  readonly C_CYAN=$'\033[36m'
  readonly C_RESET=$'\033[0m'
else
  readonly C_BOLD=""
  readonly C_GREEN=""
  readonly C_YELLOW=""
  readonly C_RED=""
  readonly C_CYAN=""
  readonly C_RESET=""
fi

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }
}

if ! command -v docker >/dev/null 2>&1; then
  if [[ -n "$bundle_path" ]]; then
    echo "Aviso: Docker ausente; o bundle será gerado sem artefatos de contêiner." >&2
  else
    echo "Erro: dependência ausente: docker" >&2
    exit 2
  fi
fi
need awk

fails=0
warnings=0
checks_json=()
checks_lines=()

record_check() {
  local name="$1" status="$2" detail="$3"
  checks_lines+=("$(printf '%s\t%s\t%s' "$name" "$status" "$detail")")
  if [[ "$status" == "fail" ]]; then
    fails=$((fails + 1))
    if ! $output_json; then
      printf '%s[FAIL]%s %s: %s\n' "$C_RED" "$C_RESET" "$name" "$detail"
    fi
  elif [[ "$status" == "warn" ]]; then
    warnings=$((warnings + 1))
    if ! $output_json; then
      printf '%s[WARN]%s %s: %s\n' "$C_YELLOW" "$C_RESET" "$name" "$detail"
    fi
  else
    if ! $output_json; then
      printf '%s[ OK ]%s %s%s\n' "$C_GREEN" "$C_RESET" "$name" "${detail:+ ($detail)}"
    fi
  fi
  if $output_json && command -v jq >/dev/null 2>&1; then
    checks_json+=("$(jq -nc --arg name "$name" --arg status "$status" --arg detail "$detail" '{name: $name, status: $status, detail: $detail}')")
  fi
}

! $output_json && printf '%s%s== Diagnóstico do Ambiente VPN (vpn-doctor) ==%s\n\n' "$C_CYAN" "$C_BOLD" "$C_RESET"

# 1. Dependências do host
for dep in curl jq awk docker; do
  if command -v "$dep" >/dev/null 2>&1; then
    record_check "Dependência host: ${dep}" ok ""
  else
    record_check "Dependência host: ${dep}" fail "Comando não encontrado no PATH"
  fi
done

# 2. Daemon Docker
if docker info >/dev/null 2>&1; then
  record_check "Docker daemon" ok "em execução e acessível"
else
  record_check "Docker daemon" fail "inacessível ou sem permissão de socket"
fi

# 3. Segredos locais
if [[ -d "$SECRETS_DIR" ]]; then
  record_check "Diretório .secrets/" ok "presente"
  
  if [[ -s "${SECRETS_DIR}/gluetun_api_key" ]]; then
    record_check "Arquivo gluetun_api_key" ok "presente"
  else
    record_check "Arquivo gluetun_api_key" fail "ausente em ${SECRETS_DIR}"
  fi

  # Permissões dos segredos
  while IFS= read -r secret_file; do
    [[ -n "$secret_file" ]] || continue
    perms="$(stat -c "%a" "$secret_file" 2>/dev/null || stat -f "%Lp" "$secret_file" 2>/dev/null || true)"
    basename_file="$(basename "$secret_file")"
    if [[ "$perms" == "600" || "$perms" == "400" ]]; then
      record_check "Permissão ${basename_file}" ok "modo ${perms}"
    else
      if $auto_fix; then
        chmod 600 "$secret_file"
        record_check "Permissão ${basename_file}" ok "corrigido para 0600 (era ${perms})"
      else
        record_check "Permissão ${basename_file}" warn "modo ${perms} (recomendado: chmod 600 ${secret_file})"
      fi
    fi
  done < <(find "$SECRETS_DIR" -maxdepth 1 -type f)
else
  record_check "Diretório .secrets/" fail "ausente (crie a pasta e os segredos)"
fi

# 4. Estado dos contêineres Compose
compose_ps="$(docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml" ps --format json 2>/dev/null || true)"
if [[ -n "$compose_ps" && "$compose_ps" != "[]" ]]; then
  resolve_cid() {
    docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml" ps -q "$1" 2>/dev/null | head -n 1
  }
  check_container_service() {
    local service="$1" required="$2"
    local status health state cid=""
    cid="$(resolve_cid "$service")"
    if [[ -n "$cid" ]]; then
      state="$(docker inspect --format '{{.State.Status}}' "$cid" 2>/dev/null || true)"
      health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || true)"
    else
      state=""
      health="none"
    fi

    if [[ "$state" == "running" ]]; then
      if [[ "$health" == "healthy" || "$health" == "none" ]]; then
        record_check "Serviço ${service}" ok "estado: ${state}, saúde: ${health}"
      else
        record_check "Serviço ${service}" fail "estado: ${state}, saúde: ${health}"
      fi
    else
      if $required; then
        record_check "Serviço ${service}" fail "não está em execução (status: ${state:-inexistente})"
      else
        record_check "Serviço ${service}" ok "desativado (opt-in)"
      fi
    fi
  }

  check_container_service "vpn" true
  check_container_service "terminal" true
  check_container_service "vpn-auto-reconnect" true
  check_container_service "opencode-supervisor" false
else
  record_check "Contêineres Compose" fail "nenhum contêiner do projeto em execução"
fi

# 5. vpn-check interno (resolve o terminal via compose, sem nome fixo)
terminal_cid="$(docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml" ps -q terminal 2>/dev/null | head -n 1 || true)"
if [[ -n "$terminal_cid" ]]; then
  if vpn_check_out="$(docker exec "$terminal_cid" vpn-check --json 2>/dev/null)"; then
    record_check "vpn-check interno" ok "túnel e DNS saudáveis"
  else
    record_check "vpn-check interno" fail "uma ou mais verificações falharam (execute vpn-check no terminal)"
  fi
fi

# 6. OpenCode (porta local; opt-in: down vira warn, não silêncio)
opencode_port="$(awk -F= '/^OPENCODE_GUI_PORT=/ {print $2; exit}' "${ROOT_DIR}/.env" 2>/dev/null || true)"
opencode_port="${opencode_port:-10001}"
if command -v timeout >/dev/null 2>&1; then
  if timeout 2 bash -c "exec 3<>/dev/tcp/127.0.0.1/${opencode_port}" 2>/dev/null; then
    record_check "Porta OpenCode (${opencode_port})" ok "respondendo no host"
  else
    record_check "Porta OpenCode (${opencode_port})" warn "nada ouvindo (opt-in; suba com vpn-opencode)"
  fi
fi

# Bundle sanitizado de diagnóstico (allowlist estrita; sem segredos).
create_bundle() {
  local target="$1"
  local workdir=""
  workdir="$(mktemp -d "${TMPDIR:-/tmp}/vpn-doctor-bundle.XXXXXX")" || {
    echo "Erro: não foi possível criar o diretório temporário do bundle." >&2
    exit 1
  }
  mkdir -p "${workdir}/bundle"

  redact_stream() {
    if $redact_ips; then
      sed -E 's/([0-9]{1,3}\.){3}[0-9]{1,3}/<ip-redigido>/g; s/([0-9A-Fa-f]{0,4}:){2,7}[0-9A-Fa-f]{0,4}/<ip-redigido>/g'
    else
      cat
    fi
  }

  printf '%s\n' "${checks_lines[@]}" | redact_stream > "${workdir}/bundle/doctor.tsv"
  if command -v jq >/dev/null 2>&1; then
    jq -Rs '[split("\n")[] | select(length > 0) | split("\t") | {name: .[0], status: .[1], detail: (.[2] // "")}]' \
      "${workdir}/bundle/doctor.tsv" > "${workdir}/bundle/doctor.json"
  fi

  {
    printf 'host=%s\n' "$(uname -srm 2>/dev/null || echo desconhecido)"
    printf 'docker=%s\n' "$(docker --version 2>/dev/null || echo ausente)"
    printf 'node=%s\n' "$(node --version 2>/dev/null || echo ausente)"
    printf 'jq=%s\n' "$(jq --version 2>/dev/null || echo ausente)"
    printf 'compose_profiles=vpn,opencode\n'
  } | redact_stream > "${workdir}/bundle/environment.txt"

  if [[ -f "${ROOT_DIR}/.env" ]]; then
    awk -F= '/^[A-Za-z_][A-Za-z0-9_]*=/ {print $1}' "${ROOT_DIR}/.env" | sort -u \
      > "${workdir}/bundle/env-keys.txt"
  else
    : > "${workdir}/bundle/env-keys.txt"
  fi

  docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml" ps 2>/dev/null \
    | redact_stream > "${workdir}/bundle/compose-ps.txt" || true

  if [[ -n "${terminal_cid:-}" ]]; then
    docker exec "$terminal_cid" vpn-check --json 2>/dev/null \
      | redact_stream > "${workdir}/bundle/vpn-check.json" || true
    docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml" logs --tail=100 terminal 2>/dev/null \
      | redact_stream > "${workdir}/bundle/logs-terminal.txt" || true
  else
    : > "${workdir}/bundle/vpn-check.json"
    : > "${workdir}/bundle/logs-terminal.txt"
  fi

  docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml" logs --tail=100 vpn 2>/dev/null \
    | redact_stream > "${workdir}/bundle/logs-vpn.txt" || true

  {
    printf 'vpn-doctor bundle\n'
    printf 'redact_ips=%s\n' "$redact_ips"
    printf 'arquivos:\n'
    (cd "${workdir}/bundle" && find . -type f | sed 's|^\./||' | sort)
  } > "${workdir}/bundle/manifest.txt"

  mkdir -p "$(dirname -- "$target")"
  tar -czf "$target" -C "${workdir}/bundle" .
  rm -rf "$workdir"

  if ! $output_json; then
    printf 'Bundle de diagnóstico: %s\n' "$target"
  fi
}

if [[ -n "$bundle_path" ]]; then
  create_bundle "$bundle_path"
fi

# Resumo
if $output_json && command -v jq >/dev/null 2>&1; then
  jq -nc \
    --argjson fails "$fails" \
    --argjson warnings "$warnings" \
    --argjson checks "$(printf '%s\n' "${checks_json[@]:-}" | jq -s .)" \
    '{healthy: ($fails == 0), fails: $fails, warnings: $warnings, checks: $checks}'
else
  printf '\n'
  if (( fails == 0 )); then
    printf '%s%sResultado: Ambiente saudável! (%d aviso(s))%s\n' "$C_GREEN" "$C_BOLD" "$warnings" "$C_RESET"
    exit 0
  else
    printf '%s%sResultado: %d falha(s) detectada(s).%s\n' "$C_RED" "$C_BOLD" "$fails" "$C_RESET"
    exit 1
  fi
fi
