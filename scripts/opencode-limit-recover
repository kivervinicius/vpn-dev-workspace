#!/usr/bin/env bash
set -Eeuo pipefail

if [[ "$#" -gt 0 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  cat >&2 <<'HELP'
Usage: opencode-limit-recover --event <class> [--retry-after <seconds>]

Provider quota events are status-only. This helper never changes VPN state,
runs provider probes, or repeats a model turn.
HELP
  exit 0
fi

event=""
retry_after=""
while (($#)); do
  case "$1" in
    --event)
      (($# >= 2)) || { echo "Missing value for --event" >&2; exit 2; }
      event="$2"; shift 2 ;;
    --retry-after)
      (($# >= 2)) || { echo "Missing value for --retry-after" >&2; exit 2; }
      retry_after="$2"; shift 2 ;;
    *) echo "Unexpected argument: $1" >&2; exit 2 ;;
  esac
done

case "$event" in
  free_tier_limit|rate_limit|account_limit|credit_limit|auth_limit) ;;
  *) echo "Unsupported provider event: $event" >&2; exit 2 ;;
esac
if [[ -n "$retry_after" && ! "$retry_after" =~ ^[1-9][0-9]*$ ]]; then
  echo "Retry-After must be a positive integer" >&2
  exit 2
fi
jq -cn \
  --arg event "$event" \
  --arg retry_after "$retry_after" \
  '{
    status: "skipped",
    reason: "quota_status_only",
    event: $event,
    retry_after: (if $retry_after == "" then null else ($retry_after | tonumber) end),
    vpn_ready: false,
    current_ip: ""
  }'
