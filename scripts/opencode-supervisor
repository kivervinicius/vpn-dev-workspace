#!/usr/bin/env bash
# Supervisão autônoma do OpenCode dentro do namespace da VPN.
# Não usa Docker socket: controla o processo filho OpenCode e a VPN pela API do Gluetun.
set -Eeuo pipefail

MODE="${OPENCODE_SUPERVISOR_MODE:-serve}"
PORT="${OPENCODE_GUI_PORT:-10001}"
INTERVAL="${OPENCODE_SUPERVISOR_INTERVAL_SECONDS:-10}"
COOLDOWN="${OPENCODE_RECOVERY_COOLDOWN_SECONDS:-30}"
WINDOW_SECONDS="${OPENCODE_RECOVERY_WINDOW_SECONDS:-900}"
MAX_ROTATIONS="${OPENCODE_RECOVERY_MAX_ROTATIONS:-3}"
READY_ATTEMPTS="${OPENCODE_READY_ATTEMPTS:-30}"
READY_DELAY="${OPENCODE_READY_DELAY_SECONDS:-2}"
VPN_READY_ATTEMPTS="${OPENCODE_VPN_READY_ATTEMPTS:-30}"
VPN_READY_DELAY="${OPENCODE_VPN_READY_DELAY_SECONDS:-2}"
LOG_FILE="${OPENCODE_SUPERVISOR_LOG_FILE:-/tmp/opencode-supervisor/opencode.log}"
PID_FILE="${OPENCODE_SUPERVISOR_PID_FILE:-/tmp/opencode-supervisor/opencode.pid}"
SESSION_STATE_FILE="${OPENCODE_SUPERVISOR_SESSION_FILE:-${HOME:-/home/developer}/.local/state/vpn-dev-workspace/opencode-resume-session}"
FREE_TIER_LIMIT_PATTERNS="${OPENCODE_FREE_TIER_LIMIT_PATTERNS:-freeusagelimiterror|free_tier_limit|free limit reached|free usage exceeded.*subscribe to go|subscribe to go}"
ACCOUNT_LIMIT_PATTERNS="${OPENCODE_ACCOUNT_LIMIT_PATTERNS:-account_rate_limit|go limit reached|weekly usage limit reached|monthly usage limit reached|usage limit reached.*reset}"
RATE_LIMIT_PATTERNS="${OPENCODE_RATE_LIMIT_PATTERNS:-${OPENCODE_LIMIT_PATTERNS:-provider rate limit exceeded|too many requests|too_many_requests|http[^0-9]*429|status[^0-9]*429|rate[ -]?limit exceeded}}"
DISCONNECT_PATTERNS="${OPENCODE_DISCONNECT_PATTERNS:-network connection lost|connection lost|connection reset|econnreset|etimedout|network error|network request failed|fetch failed|socket hang up|provider.*disconnected|upstream.*disconnected|stream.*disconnected}"
PASSWORD_FILE="${OPENCODE_GUI_PASSWORD_FILE:-/run/secrets/opencode_gui_password}"

child_pid=""
log_offset=0
rotations=0
window_started="$(date +%s)"
last_recovery=0
pending_vpn_reason=""
resume_session_id=""

usage() {
  cat >&2 <<'EOF'
Uso: opencode-supervisor [--help] [--classify <texto>]

Executa e supervisiona OpenCode dentro da VPN.
- queda do processo com VPN saudável: reinicia somente OpenCode;
- desconexão/erro de rede: rotaciona VPN, aguarda saúde e reinicia OpenCode;
- provider rate limit/429: rotaciona VPN, aguarda saúde e reinicia OpenCode;
- free tier limit/banner "subscribe to Go": mantém o app vivo; VPN não altera a franquia da conta;
- Go account limit: mantém o app vivo; VPN não altera o limite da conta;
- limita rotações por janela/cooldown para evitar loops.

Configuração principal:
  OPENCODE_SUPERVISOR_MODE=serve|web
  OPENCODE_GUI_PORT=10001
  OPENCODE_SUPERVISOR_INTERVAL_SECONDS=10
  OPENCODE_RECOVERY_COOLDOWN_SECONDS=30
  OPENCODE_RECOVERY_WINDOW_SECONDS=900
  OPENCODE_RECOVERY_MAX_ROTATIONS=3
  OPENCODE_READY_ATTEMPTS=30
  OPENCODE_READY_DELAY_SECONDS=2
  OPENCODE_VPN_READY_ATTEMPTS=30
  OPENCODE_VPN_READY_DELAY_SECONDS=2
  OPENCODE_SUPERVISOR_SESSION_FILE=<path opcional; padrão na home persistente>
  OPENCODE_FREE_TIER_LIMIT_PATTERNS=<regex>
  OPENCODE_ACCOUNT_LIMIT_PATTERNS=<regex>
  OPENCODE_RATE_LIMIT_PATTERNS=<regex>
  OPENCODE_DISCONNECT_PATTERNS=<regex>
EOF
}

classify_text() {
  local text="$1"
  if [[ -n "$text" ]] && printf '%s\n' "$text" | grep -Eiq "($FREE_TIER_LIMIT_PATTERNS)"; then
    printf 'free_tier_limit\n'
  elif [[ -n "$text" ]] && printf '%s\n' "$text" | grep -Eiq "($ACCOUNT_LIMIT_PATTERNS)"; then
    printf 'account_limit\n'
  elif [[ -n "$text" ]] && printf '%s\n' "$text" | grep -Eiq "($RATE_LIMIT_PATTERNS)"; then
    printf 'rate_limit\n'
  elif [[ -n "$text" ]] && printf '%s\n' "$text" | grep -Eiq "($DISCONNECT_PATTERNS)"; then
    printf 'disconnect\n'
  else
    printf 'none\n'
  fi
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi
if [[ "${1:-}" == "--classify" ]]; then
  [[ $# -eq 2 ]] || { echo "Erro: --classify exige exatamente um texto." >&2; exit 2; }
  classify_text "$2"
  exit 0
fi
[[ $# -eq 0 ]] || { echo "Erro: argumento desconhecido: $1" >&2; usage; exit 2; }

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }
}

resolve_helper() {
  if command -v "$1" >/dev/null 2>&1; then
    command -v "$1"
  elif [[ -x "/usr/local/bin/$1" ]]; then
    printf '/usr/local/bin/%s\n' "$1"
  else
    return 1
  fi
}

validate_positive() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || { echo "Erro: ${name} deve ser inteiro positivo (recebido: ${value})." >&2; exit 2; }
}

validate_nonnegative() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[0-9]+$ ]] || { echo "Erro: ${name} deve ser inteiro >= 0 (recebido: ${value})." >&2; exit 2; }
}

need curl
need grep
need jq
need opencode

[[ "$MODE" == "serve" || "$MODE" == "web" ]] || { echo "Erro: OPENCODE_SUPERVISOR_MODE deve ser serve|web." >&2; exit 2; }
[[ "$PORT" =~ ^[1-9][0-9]{0,4}$ && "$PORT" -le 65535 ]] || { echo "Erro: OPENCODE_GUI_PORT inválida: $PORT." >&2; exit 2; }
validate_positive OPENCODE_SUPERVISOR_INTERVAL_SECONDS "$INTERVAL"
validate_nonnegative OPENCODE_RECOVERY_COOLDOWN_SECONDS "$COOLDOWN"
validate_positive OPENCODE_RECOVERY_WINDOW_SECONDS "$WINDOW_SECONDS"
validate_positive OPENCODE_RECOVERY_MAX_ROTATIONS "$MAX_ROTATIONS"
validate_positive OPENCODE_READY_ATTEMPTS "$READY_ATTEMPTS"
validate_nonnegative OPENCODE_READY_DELAY_SECONDS "$READY_DELAY"
validate_positive OPENCODE_VPN_READY_ATTEMPTS "$VPN_READY_ATTEMPTS"
validate_nonnegative OPENCODE_VPN_READY_DELAY_SECONDS "$VPN_READY_DELAY"

mkdir -p "$(dirname "$LOG_FILE")" "$(dirname "$PID_FILE")" "$(dirname "$SESSION_STATE_FILE")"
touch "$LOG_FILE"

load_server_auth() {
  if [[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]]; then
    export OPENCODE_SERVER_USER="${OPENCODE_SERVER_USER:-opencode}"
    return
  fi
  if [[ -r "$PASSWORD_FILE" ]]; then
    local pass
    pass="$(tr -d '\r\n' < "$PASSWORD_FILE" 2>/dev/null || true)"
    if [[ -n "$pass" ]]; then
      export OPENCODE_SERVER_PASSWORD="$pass"
      export OPENCODE_SERVER_USER="${OPENCODE_SERVER_USER:-opencode}"
    fi
  fi
}

http_ready() {
  local -a auth=()
  if [[ -n "${OPENCODE_SERVER_PASSWORD:-}" ]]; then
    auth=(-u "${OPENCODE_SERVER_USER:-opencode}:${OPENCODE_SERVER_PASSWORD}")
  fi
  curl --silent --show-error --output /dev/null \
    --connect-timeout 3 --max-time 5 \
    "${auth[@]}" "http://127.0.0.1:${PORT}/"
}

start_opencode() {
  load_server_auth
  : > "$LOG_FILE"
  log_offset=0
  echo "Iniciando OpenCode ${MODE} em 127.0.0.1:${PORT}..."
  opencode "$MODE" --port "$PORT" --hostname 0.0.0.0 >>"$LOG_FILE" 2>&1 &
  child_pid=$!
  printf '%s\n' "$child_pid" > "$PID_FILE"
}

stop_opencode() {
  if [[ -n "$child_pid" ]] && kill -0 "$child_pid" 2>/dev/null; then
    kill -TERM "$child_pid" 2>/dev/null || true
    for _ in {1..10}; do
      kill -0 "$child_pid" 2>/dev/null || break
      sleep 1
    done
    kill -KILL "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  child_pid=""
  rm -f "$PID_FILE"
}

wait_ready() {
  local attempt
  for ((attempt=1; attempt<=READY_ATTEMPTS; attempt++)); do
    if [[ -n "$child_pid" ]] && ! kill -0 "$child_pid" 2>/dev/null; then
      echo "OpenCode encerrou antes de ficar pronto." >&2
      return 1
    fi
    if http_ready; then
      echo "OpenCode pronto após recuperação."
      return 0
    fi
    sleep "$READY_DELAY"
  done
  echo "OpenCode não ficou pronto após ${READY_ATTEMPTS} tentativas." >&2
  return 1
}

read_new_logs() {
  local size chunk=""
  size="$(wc -c < "$LOG_FILE" | tr -d '[:space:]')"
  [[ "$size" =~ ^[0-9]+$ ]] || size=0
  if (( size < log_offset )); then
    log_offset=0
  fi
  if (( size > log_offset )); then
    chunk="$(tail -c "+$((log_offset + 1))" "$LOG_FILE" 2>/dev/null || true)"
    log_offset="$size"
  fi
  printf '%s' "$chunk"
}

capture_resume_session() {
  local json id
  json="$(opencode session list --format json -n 1 2>/dev/null || true)"
  id="$(printf '%s' "$json" | jq -r 'if type == "array" and length > 0 then .[0].id // empty else empty end' 2>/dev/null || true)"
  if [[ -n "$id" && "$id" != "null" ]]; then
    resume_session_id="$id"
    printf '%s\n' "$resume_session_id" > "$SESSION_STATE_FILE"
    echo "Sessão OpenCode preservada para retomada de contexto: ${resume_session_id}."
    return 0
  fi

  resume_session_id=""
  rm -f "$SESSION_STATE_FILE"
  return 0
}

verify_resume_session() {
  local target json
  target="$resume_session_id"
  if [[ -z "$target" && -r "$SESSION_STATE_FILE" ]]; then
    target="$(tr -d '\r\n' < "$SESSION_STATE_FILE" 2>/dev/null || true)"
  fi
  [[ -n "$target" ]] || return 0

  json="$(opencode session list --format json -n 50 2>/dev/null || true)"
  if printf '%s' "$json" | jq -e --arg id "$target" 'any(.[]?; .id == $id)' >/dev/null 2>&1; then
    echo "Contexto preservado: sessão ${target} continua disponível após a recuperação."
    return 0
  fi

  echo "Aviso: a sessão ${target} não apareceu na listagem após reiniciar o OpenCode; nenhuma requisição será repetida automaticamente." >&2
  return 1
}

vpn_is_healthy() {
  local helper
  helper="$(resolve_helper vpn-check)" || return 1
  "$helper" --only tunnel -q >/dev/null 2>&1
}

wait_vpn_ready() {
  local attempt
  for ((attempt=1; attempt<=VPN_READY_ATTEMPTS; attempt++)); do
    if vpn_is_healthy; then
      echo "VPN saudável após recuperação."
      return 0
    fi
    if (( attempt < VPN_READY_ATTEMPTS )); then
      sleep "$VPN_READY_DELAY"
    fi
  done
  echo "VPN não ficou saudável após ${VPN_READY_ATTEMPTS} tentativas." >&2
  return 1
}

wait_recovery_cooldown() {
  local now elapsed remaining
  (( COOLDOWN > 0 )) || return 0
  now="$(date +%s)"
  elapsed=$((now - last_recovery))
  remaining=$((COOLDOWN - elapsed))
  if (( remaining > 0 )); then
    echo "Aguardando ${remaining}s antes de tentar outro servidor VPN..." >&2
    sleep "$remaining"
  fi
}

reset_rotation_window_if_needed() {
  local now
  now="$(date +%s)"
  if (( now - window_started >= WINDOW_SECONDS )); then
    window_started="$now"
    rotations=0
  fi
}

rotation_allowed() {
  local now
  reset_rotation_window_if_needed
  now="$(date +%s)"
  if (( rotations >= MAX_ROTATIONS )); then
    echo "Proteção anti-loop: ${rotations}/${MAX_ROTATIONS} rotações já executadas nesta janela de ${WINDOW_SECONDS}s." >&2
    return 1
  fi
  if (( last_recovery > 0 && now - last_recovery < COOLDOWN )); then
    echo "Cooldown de recuperação ativo; nova rotação adiada." >&2
    return 1
  fi
  last_recovery="$now"
  rotations=$((rotations + 1))
  return 0
}

rotate_vpn() {
  local rotate reconnect hostnames count
  rotate="$(resolve_helper vpn-server-rotate)" || { echo "Erro: vpn-server-rotate ausente." >&2; return 1; }
  reconnect="$(resolve_helper vpn-reconnect)" || { echo "Erro: vpn-reconnect ausente." >&2; return 1; }

  hostnames="${VPN_SERVER_HOSTNAMES:-}"
  count=0
  if [[ -n "$hostnames" ]]; then
    IFS=',' read -r -a _hosts <<< "$hostnames"
    for _host in "${_hosts[@]}"; do
      _host="${_host#"${_host%%[![:space:]]*}"}"
      _host="${_host%"${_host##*[![:space:]]}"}"
      [[ -n "$_host" ]] && count=$((count + 1))
    done
  fi

  echo "Rotacionando VPN antes de retomar o OpenCode..."
  if (( count == 1 )); then
    "$rotate" --random && return 0
  else
    "$rotate" && return 0
  fi

  echo "Rotação falhou; tentando apenas reconectar o túnel atual." >&2
  "$reconnect"
}

recover_with_vpn() {
  local reason="$1"

  pending_vpn_reason=""
  echo "Recuperação OpenCode acionada por: ${reason}."
  capture_resume_session
  stop_opencode

  while true; do
    if ! rotation_allowed; then
      pending_vpn_reason="$reason"
      echo "Recuperação por VPN pausada pelo anti-loop (${reason}); será retomada após cooldown/janela." >&2
      return 1
    fi

    if rotate_vpn && wait_vpn_ready; then
      start_opencode
      if wait_ready; then
        verify_resume_session || true
        return 0
      fi

      echo "OpenCode não ficou pronto apesar da VPN saudável; a sessão persistida foi mantida e o supervisor tentará recuperar o processo no próximo ciclo." >&2
      return 1
    fi

    echo "Servidor VPN ainda indisponível; tentando outro servidor dentro da política anti-loop." >&2
    wait_recovery_cooldown
  done
}

recover_process_only() {
  echo "OpenCode caiu, mas a VPN está saudável; reiniciando apenas a aplicação." >&2
  stop_opencode
  start_opencode
  wait_ready
}

shutdown() {
  echo "Encerrando supervisor do OpenCode..."
  stop_opencode
  exit 0
}
trap shutdown TERM INT

start_opencode
if ! wait_ready; then
  if vpn_is_healthy; then
    recover_process_only || true
  else
    recover_with_vpn "startup-vpn-unhealthy" || true
  fi
fi

echo "Supervisor ativo: mode=${MODE}, port=${PORT}, interval=${INTERVAL}s, max-rotations=${MAX_ROTATIONS}/${WINDOW_SECONDS}s."

while true; do
  sleep "$INTERVAL"

  if [[ -n "$pending_vpn_reason" ]]; then
    pending_reason="$pending_vpn_reason"
    if recover_with_vpn "$pending_reason"; then
      continue
    fi
    if [[ -n "$pending_vpn_reason" ]]; then
      continue
    fi
  fi

  if [[ -z "$child_pid" ]] || ! kill -0 "$child_pid" 2>/dev/null; then
    if vpn_is_healthy; then
      recover_process_only || true
    else
      recover_with_vpn "process-down-and-vpn-unhealthy" || true
    fi
    continue
  fi

  new_logs="$(read_new_logs)"
  event="$(classify_text "$new_logs")"
  case "$event" in
    free_tier_limit)
      echo "OpenCode atingiu o limite da franquia gratuita (banner subscribe to Go); rotação de VPN não altera free_tier_limit. Mantendo o processo vivo para troca de conta/plano/provider ou reset da própria conta." >&2
      continue
      ;;
    account_limit)
      echo "OpenCode Go atingiu limite de conta; rotação de VPN não altera account_rate_limit. Mantendo o processo vivo até o reset/fallback do próprio OpenCode." >&2
      continue
      ;;
    rate_limit)
      recover_with_vpn "opencode-provider-rate-limit" || true
      continue
      ;;
    disconnect)
      recover_with_vpn "opencode-disconnect" || true
      continue
      ;;
  esac

  if ! http_ready; then
    if vpn_is_healthy; then
      recover_process_only || true
    else
      recover_with_vpn "http-down-and-vpn-unhealthy" || true
    fi
  fi
done
