#!/usr/bin/env bash
# vpn-hosts-apply: acrescenta o snippet de hosts locais (.hosts.local.gen) ao
# /etc/hosts de `terminal`, `vpn-auto-reconnect` e, quando ativo, `opencode-supervisor`.
#
# Idempotente (não duplica entradas). Chamado pelo vpn-switch após o up;
# uso manual (ex: após `restart`): ./scripts/vpn-hosts-apply [--dry-run]
# O --dry-run só imprime o que seria aplicado (sem Docker).
set -Eeuo pipefail

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly SNIPPET_FILE="${VPN_HOSTS_SNIPPET_FILE:-${ROOT_DIR}/.hosts.local.gen}"
readonly REQUIRED_SERVICES=(terminal vpn-auto-reconnect)
readonly OPTIONAL_SERVICES=(opencode-supervisor)

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }
}

dry_run=false
if [[ "${1:-}" == "--dry-run" ]]; then
  dry_run=true
elif [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Uso: vpn-hosts-apply [--dry-run] [--help]" >&2
  echo "Injeta o snippet no /etc/hosts de terminal, vpn-auto-reconnect e supervisor ativo (idempotente)." >&2
  exit 0
elif [[ -n "${1:-}" ]]; then
  echo "Uso: vpn-hosts-apply [--dry-run]" >&2
  exit 2
fi

[[ -f "$SNIPPET_FILE" ]] || { echo "Sem snippet de hosts locais; nada a aplicar."; exit 0; }

ips=()
names=()
while IFS= read -r line || [[ -n "$line" ]]; do
  line="${line%%#*}"
  [[ -n "${line//[[:space:]]/}" ]] || continue
  read -r -a fields <<< "$line"
  if ((${#fields[@]} != 2)); then
    echo "Erro: linha inválida no snippet ${SNIPPET_FILE}: '${line}'." >&2
    exit 2
  fi
  ips+=("${fields[0]}")
  names+=("${fields[1]}")
done < "$SNIPPET_FILE"

((${#names[@]} > 0)) || { echo "Snippet sem entradas; nada a aplicar."; exit 0; }

if $dry_run; then
  for svc in "${REQUIRED_SERVICES[@]}" "${OPTIONAL_SERVICES[@]}"; do
    for i in "${!names[@]}"; do
      printf '[%s] %s %s >> /etc/hosts\n' "$svc" "${ips[$i]}" "${names[$i]}"
    done
  done
  exit 0
fi

need docker
compose=(docker compose --profile vpn --profile opencode -f "${ROOT_DIR}/docker-compose.yml")

# Re-valida o snippet antes do exec como root (o arquivo pode ser editado à mão).
valid_hostname() {
  local h="$1"
  [[ "$h" =~ ^[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?$ ]] || return 1
  [[ "$h" != *".."* ]] || return 1
  [[ "$h" != *"*"* && "$h" != *"'"* && "$h" != *'"'* && "$h" != *'`'* && "$h" != *'$'* && "$h" != *';'* && "$h" != *'&'* && "$h" != *'|'* ]] || return 1
  return 0
}
valid_ip() {
  local ip="$1"
  [[ "$ip" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] && (( 10#${BASH_REMATCH[1]} <= 255 && 10#${BASH_REMATCH[2]} <= 255 && 10#${BASH_REMATCH[3]} <= 255 && 10#${BASH_REMATCH[4]} <= 255 )) && return 0
  [[ "$ip" == *:* && "$ip" =~ ^[0-9a-fA-F:.]+$ && "$ip" != *":::"* ]] && return 0
  return 1
}

for svc in "${REQUIRED_SERVICES[@]}"; do
  cid="$("${compose[@]}" ps -q "$svc" 2>/dev/null || true)"
  [[ -n "$cid" ]] || { echo "Erro: contêiner '${svc}' não está rodando; aplique após o vpn-switch." >&2; exit 1; }
  for i in "${!names[@]}"; do
    ip="${ips[$i]}"
    name="${names[$i]}"
    valid_ip "$ip" || { echo "Erro: IP inválido no snippet: '${ip}'." >&2; exit 2; }
    valid_hostname "$name" || { echo "Erro: hostname inválido no snippet: '${name}'." >&2; exit 2; }
    esc_ip="${ip//./\\.}"
    esc_name="${name//./\\.}"
    if docker exec -u 0 "$cid" sh -c "grep -Eq '^${esc_ip}[[:space:]]+${esc_name}([[:space:]]|\$)' /etc/hosts" 2>/dev/null; then
      echo "[${svc}] ${name} já mapeado; pulando."
    else
      docker exec -u 0 "$cid" sh -c 'printf "%s %s\n" "$1" "$2" >> /etc/hosts' sh "$ip" "$name"
      echo "[${svc}] ${ip} ${name} aplicado."
    fi
  done
done


for svc in "${OPTIONAL_SERVICES[@]}"; do
  cid="$("${compose[@]}" ps -q "$svc" 2>/dev/null || true)"
  [[ -n "$cid" ]] || continue
  for i in "${!names[@]}"; do
    ip="${ips[$i]}"
    name="${names[$i]}"
    valid_ip "$ip" || { echo "Erro: IP inválido no snippet: '${ip}'." >&2; exit 2; }
    valid_hostname "$name" || { echo "Erro: hostname inválido no snippet: '${name}'." >&2; exit 2; }
    esc_ip="${ip//./\\.}"
    esc_name="${name//./\\.}"
    if docker exec -u 0 "$cid" sh -c "grep -Eq '^${esc_ip}[[:space:]]+${esc_name}([[:space:]]|\$)' /etc/hosts" 2>/dev/null; then
      echo "[${svc}] ${name} já mapeado; pulando."
    else
      docker exec -u 0 "$cid" sh -c 'printf "%s %s\n" "$1" "$2" >> /etc/hosts' sh "$ip" "$name"
      echo "[${svc}] ${ip} ${name} aplicado."
    fi
  done
done
