#!/usr/bin/env bash
set -Eeuo pipefail

readonly API_URL="${GLUETUN_API_URL:-http://127.0.0.1:8000}"
readonly API_KEY_FILE="${GLUETUN_API_KEY_FILE:-/run/secrets/gluetun_api_key}"
readonly RECONNECT_STATE_FILE=/tmp/vpn-auto-reconnect.state

if [[ -t 1 ]]; then
  readonly C_BOLD=$'\033[1m'
  readonly C_CYAN=$'\033[36m'
  readonly C_GREEN=$'\033[32m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_RED=$'\033[31m'
  readonly C_RESET=$'\033[0m'
else
  readonly C_BOLD=""
  readonly C_CYAN=""
  readonly C_GREEN=""
  readonly C_YELLOW=""
  readonly C_RED=""
  readonly C_RESET=""
fi

section() {
  printf "${C_BOLD}%s${C_RESET}\n" "$1"
}

printf "${C_CYAN}${C_BOLD}== VPN Dev Workspace ==${C_RESET}\n\n"

section "Serviços do ambiente"
project="${COMPOSE_PROJECT_NAME:-$(basename "${COMPOSE_PROJECT_DIR:-$PWD}")}"
if command -v docker >/dev/null 2>&1; then
  format='table {{.Service}}\t{{.Status}}\t{{.Ports}}'
  labels="label=com.docker.compose.project=${project}"
  if docker ps -a --format "$format" --filter "$labels" 2>/dev/null | grep -q .; then
    docker ps -a --format "$format" --filter "$labels"
  else
    printf "${C_YELLOW}Nenhum contêiner do projeto '%s' encontrado (ambiente não iniciado?).${C_RESET}\n" "$project"
  fi
  printf " (projeto: ${C_CYAN}%s${C_RESET})\n" "$project"
else
  printf "${C_YELLOW}docker indisponível neste ambiente.${C_RESET}\n"
fi

echo

section "Gluetun (túnel)"
if command -v jq >/dev/null 2>&1 && [[ -r "$API_KEY_FILE" ]]; then
  api_key="$(tr -d '\r\n' < "$API_KEY_FILE")"
  api_request() {
    curl --fail --silent --show-error -H "X-API-Key: ${api_key}" "$@"
  }
  if vpn_status="$(api_request "${API_URL}/v1/vpn/status" 2>/dev/null)"; then
    case "$(printf '%s' "$vpn_status" | jq -r '.status')" in
      running) printf "VPN:        ${C_GREEN}running${C_RESET}\n" ;;
      stopped) printf "VPN:        ${C_RED}stopped${C_RESET}\n" ;;
      *) printf "VPN:        ${C_YELLOW}%s${C_RESET}\n" "$(printf '%s' "$vpn_status" | jq -r '.status')" ;;
    esac

    settings="$(api_request "${API_URL}/v1/vpn/settings")"
    printf 'Perfil:     %s (%s)\n' \
      "$(printf '%s' "$settings" | jq -r '.provider.name // "?"')" \
      "$(printf '%s' "$settings" | jq -r '.type // "?"')"
    hostnames="$(printf '%s' "$settings" | jq -r '.provider.server_selection.hostnames // [] | join(", ")')"
    countries="$(printf '%s' "$settings" | jq -r '.provider.server_selection.countries // [] | join(", ")')"
    [[ -n "$hostnames" ]] && printf 'Servidor(es): %s\n' "$hostnames"
    [[ -n "$countries" ]] && printf 'País(es):    %s\n' "$countries"

    ip_data="$(api_request "${API_URL}/v1/publicip/ip" 2>/dev/null || true)"
    ip="$(printf '%s' "$ip_data" | jq -r '.public_ip // empty')"
    if [[ -n "$ip" ]]; then
      city="$(printf '%s' "$ip_data" | jq -r '.city // empty')"
      region="$(printf '%s' "$ip_data" | jq -r '.region // empty')"
      country="$(printf '%s' "$ip_data" | jq -r '.country // empty')"
      location=""
      if [[ -n "$country" ]]; then
        location="$country"
        [[ -n "$region" ]] && location="${region}, ${location}"
        [[ -n "$city" ]] && location="${city}, ${location}"
      fi
      printf "IP público: ${C_GREEN}%s${C_RESET}%s\n" "$ip" "${location:+ (${location})}"
    else
      printf "IP público: ${C_YELLOW}ainda não disponível${C_RESET}\n"
    fi

    dns_status="$(api_request "${API_URL}/v1/dns/status" 2>/dev/null || true)"
    case "$(printf '%s' "$dns_status" | jq -r '.status // empty')" in
      running) printf "DNS túnel:  ${C_GREEN}running${C_RESET}\n" ;;
      "") printf "DNS túnel:  ${C_YELLOW}indisponível${C_RESET}\n" ;;
      *) printf "DNS túnel:  ${C_YELLOW}%s${C_RESET}\n" "$(printf '%s' "$dns_status" | jq -r '.status')" ;;
    esac
  else
    printf "${C_YELLOW}API do Gluetun inacessível em %s.${C_RESET}\n" "$API_URL"
    printf "Execute ${C_BOLD}vpn-top${C_RESET} dentro do terminal do ambiente, ou publique a porta de controle do Gluetun.\n"
  fi
else
  printf "${C_YELLOW}Sem jq e/ou chave da API neste ambiente; seção do túnel indisponível.${C_RESET}\n"
  printf "Dentro do terminal do ambiente: ${C_BOLD}vpn-top${C_RESET}\n"
fi

echo

section "Auto-reconexão"
if [[ -f "$RECONNECT_STATE_FILE" ]]; then
  state="$(tr -d '\r\n' < "$RECONNECT_STATE_FILE" | head -n 1)"
  case "$state" in
    healthy) printf "Estado:   ${C_GREEN}%s${C_RESET}\n" "$state" ;;
    starting) printf "Estado:   ${C_YELLOW}%s${C_RESET}\n" "$state" ;;
    *) printf "Estado:   ${C_RED}%s${C_RESET}\n" "$state" ;;
  esac
  printf 'Intervalo: %ss (retry: %ss)\n' \
    "${VPN_RECONNECT_INTERVAL_SECONDS:-3600}" \
    "${VPN_RECONNECT_RETRY_SECONDS:-30}"
else
  printf "${C_YELLOW}Estado indisponível fora do ambiente (host).${C_RESET}\n"
fi