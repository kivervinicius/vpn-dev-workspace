#!/usr/bin/env bash
set -Eeuo pipefail

readonly API_URL="${GLUETUN_API_URL:-http://127.0.0.1:8000}"
readonly API_KEY_FILE="${GLUETUN_API_KEY_FILE:-/run/secrets/gluetun_api_key}"
readonly RECONNECT_STATE_FILE=/tmp/vpn-auto-reconnect.state
readonly OPENCODE_PORT="${OPENCODE_GUI_PORT:-10001}"
readonly CURL_TIMEOUT_ARGS=(--connect-timeout 5 --max-time 10)

opencode_tcp_ok() {
  local p="$1"
  if command -v timeout >/dev/null 2>&1; then
    timeout 5 bash -c "exec 3<>/dev/tcp/127.0.0.1/${p}" 2>/dev/null
  else
    bash -c "exec 3<>/dev/tcp/127.0.0.1/${p}" 2>/dev/null
  fi
}

usage() {
  echo "Uso: vpn-top [--json] [--no-color]" >&2
  echo "  --json     saída máquina (objeto JSON em stdout)" >&2
  echo "  --no-color sem códigos ANSI mesmo em tty" >&2
  exit 0
}

output_json=false
no_color=false
while (($# > 0)); do
  case "$1" in
    --json) output_json=true; shift ;;
    --no-color) no_color=true; shift ;;
    -h|--help) usage ;;
    *) echo "Erro: argumento desconhecido: $1" >&2; exit 2 ;;
  esac
done

if $output_json; then
  need() { command -v "$1" >/dev/null 2>&1 || { echo "Erro: dependência ausente: $1" >&2; exit 2; }; }
  need curl
  need jq
  [[ -r "$API_KEY_FILE" ]] || { echo "Erro: segredo da API ausente: $API_KEY_FILE" >&2; exit 1; }
  api_key="$(tr -d '\r\n' < "$API_KEY_FILE")"
  jget() {
    curl --fail --silent --show-error "${CURL_TIMEOUT_ARGS[@]}" -H "X-API-Key: ${api_key}" "$@" 2>/dev/null || printf ''
  }
  vpn_status="$(jget "${API_URL}/v1/vpn/status")"
  settings="$(jget "${API_URL}/v1/vpn/settings")"
  ip_data="$(jget "${API_URL}/v1/publicip/ip")"
  dns_data="$(jget "${API_URL}/v1/dns/status")"
  auto_state=""
  [[ -f "$RECONNECT_STATE_FILE" ]] && auto_state="$(tr -d '\r\n' < "$RECONNECT_STATE_FILE" | head -n 1)"
  opencode_json='null'
  opencode_helper=""
  if command -v vpn-opencode >/dev/null 2>&1; then opencode_helper="$(command -v vpn-opencode)";
  elif [[ -x "/usr/local/bin/vpn-opencode" ]]; then opencode_helper="/usr/local/bin/vpn-opencode"; fi
  if [[ -n "$opencode_helper" ]]; then
    probe_out="$("$opencode_helper" check --port "$OPENCODE_PORT" --json 2>/dev/null || true)"
    if printf '%s' "$probe_out" | jq -e 'has("status")' >/dev/null 2>&1; then
      opencode_json="$probe_out"
    fi
  fi
  if [[ "$opencode_json" == 'null' ]]; then
    if opencode_tcp_ok "$OPENCODE_PORT"; then
      opencode_json="$(jq -nc --argjson port "$OPENCODE_PORT" '{status: "ok", port: $port, detail: "tcp-aberto"}')"
    else
      opencode_json="$(jq -nc --argjson port "$OPENCODE_PORT" '{status: "down", port: $port, detail: "tcp-fechado"}')"
    fi
  fi
  jq -nc \
    --argjson vpn_status "${vpn_status:-null}" \
    --argjson settings "${settings:-null}" \
    --argjson public_ip "${ip_data:-null}" \
    --argjson dns "${dns_data:-null}" \
    --arg auto_reconnect "$auto_state" \
    --argjson opencode "$opencode_json" \
    '{vpn: $vpn_status, settings: $settings, public_ip: $public_ip, dns: $dns, auto_reconnect: $auto_reconnect, opencode: $opencode}'
  exit 0
fi

if [[ -t 1 && "$no_color" != true ]]; then
  readonly C_BOLD=$'\033[1m'
  readonly C_CYAN=$'\033[36m'
  readonly C_GREEN=$'\033[32m'
  readonly C_YELLOW=$'\033[33m'
  readonly C_RED=$'\033[31m'
  readonly C_RESET=$'\033[0m'
else
  readonly C_BOLD=""
  readonly C_CYAN=""
  readonly C_GREEN=""
  readonly C_YELLOW=""
  readonly C_RED=""
  readonly C_RESET=""
fi

section() {
  printf '%s%s%s\n' "$C_BOLD" "$1" "$C_RESET"
}

printf '%s%s== VPN Dev Workspace ==%s\n\n' "$C_CYAN" "$C_BOLD" "$C_RESET"

section "Serviços do ambiente"
project="${COMPOSE_PROJECT_NAME:-$(basename "${COMPOSE_PROJECT_DIR:-$PWD}")}"
if command -v docker >/dev/null 2>&1; then
  format='table {{.Service}}\t{{.Status}}\t{{.Ports}}'
  labels="label=com.docker.compose.project=${project}"
  if docker ps -a --format "$format" --filter "$labels" 2>/dev/null | grep -q .; then
    docker ps -a --format "$format" --filter "$labels"
  else
    printf '%sNenhum contêiner do projeto %s encontrado (ambiente não iniciado?).%s\n' "$C_YELLOW" "$project" "$C_RESET"
  fi
  printf ' (projeto: %s%s%s)\n' "$C_CYAN" "$project" "$C_RESET"
else
  printf '%sdocker indisponível neste ambiente.%s\n' "$C_YELLOW" "$C_RESET"
fi

echo

section "Gluetun (túnel)"
if ! command -v curl >/dev/null 2>&1; then
  printf '%scurl indisponível; seção do túnel indisponível.%s\n' "$C_YELLOW" "$C_RESET"
elif ! command -v jq >/dev/null 2>&1 || [[ ! -r "$API_KEY_FILE" ]]; then
  printf '%sSem jq e/ou chave da API neste ambiente; seção do túnel indisponível.%s\n' "$C_YELLOW" "$C_RESET"
  printf 'Dentro do terminal do ambiente: %svpn-top%s\n' "$C_BOLD" "$C_RESET"
else
  api_key="$(tr -d '\r\n' < "$API_KEY_FILE")"
  api_request() {
    curl --fail --silent --show-error "${CURL_TIMEOUT_ARGS[@]}" -H "X-API-Key: ${api_key}" "$@"
  }
  if vpn_status="$(api_request "${API_URL}/v1/vpn/status" 2>/dev/null)"; then
    case "$(printf '%s' "$vpn_status" | jq -r '.status // empty')" in
      running) printf 'VPN:        %srunning%s\n' "$C_GREEN" "$C_RESET" ;;
      stopped) printf 'VPN:        %sstopped%s\n' "$C_RED" "$C_RESET" ;;
      *) printf 'VPN:        %s%s%s\n' "$C_YELLOW" "$(printf '%s' "$vpn_status" | jq -r '.status // "desconhecido"')" "$C_RESET" ;;
    esac

    if ! settings="$(api_request "${API_URL}/v1/vpn/settings" 2>/dev/null)"; then
      printf '%sConfigurações do Gluetun indisponíveis (falha transitória).%s\n' "$C_YELLOW" "$C_RESET"
    else
      printf 'Perfil:     %s (%s)\n' \
        "$(printf '%s' "$settings" | jq -r '.provider.name // "?"')" \
        "$(printf '%s' "$settings" | jq -r '.type // "?"')"
      hostnames="$(printf '%s' "$settings" | jq -r '.provider.server_selection.hostnames // [] | join(", ")')"
      countries="$(printf '%s' "$settings" | jq -r '.provider.server_selection.countries // [] | join(", ")')"
      if [[ -n "$hostnames" ]]; then printf 'Servidor(es): %s\n' "$hostnames"; fi
      if [[ -n "$countries" ]]; then printf 'País(es):    %s\n' "$countries"; fi

      ip_data="$(api_request "${API_URL}/v1/publicip/ip" 2>/dev/null || true)"
      ip="$(printf '%s' "$ip_data" | jq -r '.public_ip // empty')"
      if [[ -n "$ip" ]]; then
        city="$(printf '%s' "$ip_data" | jq -r '.city // empty')"
        region="$(printf '%s' "$ip_data" | jq -r '.region // empty')"
        country="$(printf '%s' "$ip_data" | jq -r '.country // empty')"
        location=""
        if [[ -n "$country" ]]; then
          location="$country"
          [[ -n "$region" ]] && location="${region}, ${location}"
          [[ -n "$city" ]] && location="${city}, ${location}"
        fi
        printf 'IP público: %s%s%s%s\n' "$C_GREEN" "$ip" "$C_RESET" "${location:+ (${location})}"
      else
        printf 'IP público: %sainda não disponível%s\n' "$C_YELLOW" "$C_RESET"
      fi

      dns_status="$(api_request "${API_URL}/v1/dns/status" 2>/dev/null || true)"
      case "$(printf '%s' "$dns_status" | jq -r '.status // empty')" in
        running) printf 'DNS túnel:  %srunning%s\n' "$C_GREEN" "$C_RESET" ;;
        "") printf 'DNS túnel:  %sindisponível%s\n' "$C_YELLOW" "$C_RESET" ;;
        *) printf 'DNS túnel:  %s%s%s\n' "$C_YELLOW" "$(printf '%s' "$dns_status" | jq -r '.status // "desconhecido"')" "$C_RESET" ;;
      esac
    fi
  else
    printf '%sAPI do Gluetun inacessível em %s.%s\n' "$C_YELLOW" "$API_URL" "$C_RESET"
    printf 'Execute %svpn-top%s dentro do terminal do ambiente, ou publique a porta de controle do Gluetun.\n' "$C_BOLD" "$C_RESET"
  fi
fi

echo

section "Auto-reconexão"
if [[ -f "$RECONNECT_STATE_FILE" ]]; then
  state="$(tr -d '\r\n' < "$RECONNECT_STATE_FILE" | head -n 1)"
  case "$state" in
    healthy) printf 'Estado:   %s%s%s\n' "$C_GREEN" "$state" "$C_RESET" ;;
    starting) printf 'Estado:   %s%s%s\n' "$C_YELLOW" "$state" "$C_RESET" ;;
    *) printf 'Estado:   %s%s%s\n' "$C_RED" "$state" "$C_RESET" ;;
  esac
  printf 'Intervalo: %ss (retry: %ss)\n' \
    "${VPN_RECONNECT_INTERVAL_SECONDS:-3600}" \
    "${VPN_RECONNECT_RETRY_SECONDS:-30}"
else
  printf '%sEstado indisponível fora do ambiente (host).%s\n' "$C_YELLOW" "$C_RESET"
fi

echo

section "OpenCode"
if opencode_tcp_ok "$OPENCODE_PORT"; then
  printf 'Painel:   %souvindo em 127.0.0.1:%s%s\n' "$C_GREEN" "$OPENCODE_PORT" "$C_RESET"
  printf 'Detalhe:  vpn-opencode check --port %s (quota separa down de crédito esgotado)\n' "$OPENCODE_PORT"
else
  printf 'Painel:   %snada ouvindo em 127.0.0.1:%s%s\n' "$C_RED" "$OPENCODE_PORT" "$C_RESET"
  printf 'Ação:     vpn-opencode check --port %s; auto: vpn-opencode watch --port %s\n' "$OPENCODE_PORT" "$OPENCODE_PORT"
fi