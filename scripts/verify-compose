#!/usr/bin/env bash
set -Eeuo pipefail
shopt -s nullglob

readonly ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly COMPOSE_FILE="${ROOT_DIR}/docker-compose.yml"
readonly PLACEHOLDER=/dev/null

compose_env=(
  env
  "GLUETUN_API_KEY_FILE=${PLACEHOLDER}"
  "NORDVPN_USER_FILE=${PLACEHOLDER}"
  "NORDVPN_PASSWORD_FILE=${PLACEHOLDER}"
  "NORDVPN_WIREGUARD_PRIVATE_KEY_FILE=${PLACEHOLDER}"
  "PROTONVPN_USER_FILE=${PLACEHOLDER}"
  "PROTONVPN_PASSWORD_FILE=${PLACEHOLDER}"
  "PROTONVPN_WIREGUARD_PRIVATE_KEY_FILE=${PLACEHOLDER}"
  "SURFSHARK_USER_FILE=${PLACEHOLDER}"
  "SURFSHARK_PASSWORD_FILE=${PLACEHOLDER}"
  "MULLVAD_WIREGUARD_PRIVATE_KEY_FILE=${PLACEHOLDER}"
  "CUSTOM_OPENVPN_CONFIG_FILE=${PLACEHOLDER}"
  "CUSTOM_OPENVPN_USER_FILE=${PLACEHOLDER}"
  "CUSTOM_OPENVPN_PASSWORD_FILE=${PLACEHOLDER}"
  "CUSTOM_WIREGUARD_CONFIG_FILE=${PLACEHOLDER}"
)

for profile_file in "${ROOT_DIR}"/profiles/*.yml; do
  profile="$(basename "$profile_file" .yml)"
  echo "Validando perfil ${profile}..."
  "${compose_env[@]}" docker compose --profile vpn -f "$COMPOSE_FILE" -f "$profile_file" config --quiet
done

# O snippet gerado pelo vpn-hosts-gen deve ter linhas "IP nome" válidas e o
# apply deve aceitar o formato em dry-run (sem Docker).
gen_tmp="$(mktemp)"
trap 'rm -f "$gen_tmp"' EXIT
LOCAL_HOSTS="vpn-check.omega=192.168.30.5" VPN_HOSTS_SNIPPET_FILE="$gen_tmp" "${ROOT_DIR}/scripts/vpn-hosts-gen" >/dev/null
grep -Eq '^192\.168\.30\.5[[:space:]]+vpn-check\.omega$' "$gen_tmp" || {
  echo "Erro: snippet de hosts locais com conteúdo inesperado." >&2
  exit 1
}
VPN_HOSTS_SNIPPET_FILE="$gen_tmp" "${ROOT_DIR}/scripts/vpn-hosts-apply" --dry-run >/dev/null
echo "Snippet de hosts locais válido."

echo "Todos os perfis Compose são válidos."
