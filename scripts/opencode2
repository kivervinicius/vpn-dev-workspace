#!/usr/bin/env bash
# Run OpenCode v2 through the VPN terminal, except when already inside it.
set -Eeuo pipefail

# Ajuda antes de qualquer checagem de ambiente/túnel: --help nunca depende de VPN.
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  echo "Uso: opencode2 [--help] [argumentos do OpenCode]" >&2
  echo "Executa o OpenCode v2 dentro do container VPN; não há fallback no host." >&2
  exit 0
fi

readonly V2_BIN="${HOME:?HOME must be set}/.opencode/bin/opencode"
readonly TERMINAL_CONTAINER="${OPENCODE_TERMINAL_CONTAINER:-vpn-dev-workspace-terminal-1}"

if [[ "${VPN_WORKSPACE_CONTAINER:-}" == "1" ]]; then
  if [[ ! -x "$V2_BIN" ]]; then
    printf 'opencode2: v2 binary is unavailable: %s\n' "$V2_BIN" >&2
    exit 127
  fi
  if ! vpn-check --only tunnel -q >/dev/null 2>&1; then
    echo 'opencode2: VPN tunnel is unhealthy; run vpn-reconnect before starting OpenCode.' >&2
    exit 1
  fi
  exec "$V2_BIN" "$@"
fi

if ! command -v docker >/dev/null 2>&1; then
  echo 'opencode2: Docker is required; refusing to run OpenCode on the host.' >&2
  exit 1
fi
if [[ "$(docker inspect --format '{{.State.Running}}' "$TERMINAL_CONTAINER" 2>/dev/null || true)" != 'true' ]]; then
  printf 'opencode2: VPN terminal container is not running: %s\n' "$TERMINAL_CONTAINER" >&2
  exit 1
fi
if ! docker exec "$TERMINAL_CONTAINER" vpn-check --only tunnel -q >/dev/null 2>&1; then
  echo 'opencode2: VPN tunnel is unhealthy; run vpn-reconnect before starting OpenCode.' >&2
  exit 1
fi

workdir="$(pwd -P 2>/dev/null || printf /projetos)"
case "$workdir" in
  /projetos|/projetos/*|/home/*|/tmp|/tmp/*) ;;
  *) workdir=/projetos ;;
esac
readonly V2_HOME="${HOME:?HOME must be set}"
readonly V2_XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${V2_HOME}/.config}"
readonly V2_XDG_DATA_HOME="${XDG_DATA_HOME:-${V2_HOME}/.local/share}"
readonly V2_XDG_STATE_HOME="${XDG_STATE_HOME:-${V2_HOME}/.local/state}"

tty_flags=(-i)
if [[ -t 0 && -t 1 ]]; then
  tty_flags+=(-t)
fi
exec docker exec "${tty_flags[@]}" \
  -e VPN_WORKSPACE_CONTAINER=1 \
  -e HOME="$V2_HOME" \
  -e XDG_CONFIG_HOME="$V2_XDG_CONFIG_HOME" \
  -e XDG_DATA_HOME="$V2_XDG_DATA_HOME" \
  -e XDG_STATE_HOME="$V2_XDG_STATE_HOME" \
  -e TERM="${TERM:-xterm-256color}" \
  -w "$workdir" \
  "$TERMINAL_CONTAINER" \
  "$V2_BIN" "$@"
