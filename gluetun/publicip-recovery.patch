+package api
+
+import (
+	"context"
+	"github.com/qdm12/gluetun/internal/models"
+	"net/netip"
+	"strings"
+	"testing"
+)
+
+type recoveryFetcher struct {
+	name string
+	ip   netip.Addr
+}
+
+func (f *recoveryFetcher) String() string      { return f.name }
+func (f *recoveryFetcher) Token() string       { return "" }
+func (f *recoveryFetcher) CanFetchAnyIP() bool { return true }
+func (f *recoveryFetcher) FetchInfo(context.Context, netip.Addr) (models.PublicIP, error) {
+	return models.PublicIP{IP: f.ip}, nil
+}
+
+type recoveryWarner struct{}
+
+func (recoveryWarner) Warn(string) {}
+func TestRecoverySkipsBannedFetchers(t *testing.T) {
+	a := &recoveryFetcher{name: "first"}
+	b := &recoveryFetcher{name: "second", ip: netip.MustParseAddr("192.0.2.42")}
+	r := NewResilient([]Fetcher{a, b}, recoveryWarner{})
+	r.setBanned(a)
+	result, err := r.FetchInfo(context.Background(), netip.Addr{})
+	if err != nil || result.IP != b.ip {
+		t.Fatalf("result=%v error=%v", result, err)
+	}
+	r.setBanned(b)
+	_, err = r.FetchInfo(context.Background(), netip.Addr{})
+	if err == nil || !strings.Contains(err.Error(), "no eligible public IP fetchers") || strings.Contains(err.Error(), "%!w") {
+		t.Fatalf("error=%v", err)
+	}
+}
