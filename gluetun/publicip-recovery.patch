+package publicip
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/qdm12/gluetun/internal/configuration/settings"
+	"github.com/qdm12/gluetun/internal/models"
+)
+
+type recoveryLogger struct{}
+
+func (recoveryLogger) Info(string)  {}
+func (recoveryLogger) Warn(string)  {}
+func (recoveryLogger) Error(string) {}
+
+type recoveryTransport func(*http.Request) (*http.Response, error)
+
+func (f recoveryTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func recoveryLoop(t *testing.T, transport recoveryTransport) (*Loop, string) {
+	t.Helper()
+	enabled := true
+	path := filepath.Join(t.TempDir(), "ip")
+	l, err := NewLoop(settings.PublicIP{Enabled: &enabled, IPFilepath: &path, APIs: []settings.PublicIPAPI{{Name: "ifconfigco"}}}, os.Getuid(), os.Getgid(), &http.Client{Transport: transport}, recoveryLogger{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = l.Start(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		if err := l.Stop(); err != nil {
+			t.Error(err)
+		}
+	})
+	return l, path
+}
+
+func TestRecoveryAfterTimeout(t *testing.T) {
+	var calls atomic.Int32
+	l, path := recoveryLoop(t, func(*http.Request) (*http.Response, error) {
+		if calls.Add(1) == 1 {
+			return nil, context.DeadlineExceeded
+		}
+		return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(`{"ip":"192.0.2.42"}`)), Header: make(http.Header)}, nil
+	})
+	l.ipData = models.PublicIP{IP: netip.MustParseAddr("192.0.2.1")}
+	if err := os.WriteFile(path, []byte("192.0.2.1"), 0644); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.RunOnce(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != 2 || l.GetData().IP.String() != "192.0.2.42" {
+		t.Fatalf("calls=%d data=%v", calls.Load(), l.GetData())
+	}
+	data, err := os.ReadFile(path)
+	if err != nil || string(data) != "192.0.2.42" {
+		t.Fatalf("file=%q err=%v", data, err)
+	}
+}
+func TestRecoveryPersistentFailure(t *testing.T) {
+	var calls atomic.Int32
+	l, _ := recoveryLoop(t, func(*http.Request) (*http.Response, error) { calls.Add(1); return nil, context.DeadlineExceeded })
+	if err := l.RunOnce(context.Background()); err == nil {
+		t.Fatal("expected error")
+	}
+	if calls.Load() != 3 || l.GetData().IP.IsValid() {
+		t.Fatalf("calls=%d data=%v", calls.Load(), l.GetData())
+	}
+}
+func TestRecoveryCancelDuringWait(t *testing.T) {
+	called := make(chan struct{}, 2)
+	l, _ := recoveryLoop(t, func(*http.Request) (*http.Response, error) {
+		called <- struct{}{}
+		return nil, context.DeadlineExceeded
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	go func() { done <- l.RunOnce(ctx) }()
+	<-called
+	time.Sleep(100 * time.Millisecond)
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("error=%v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("cancellation blocked")
+	}
+	select {
+	case <-called:
+		t.Fatal("unexpected second request")
+	default:
+	}
+}
