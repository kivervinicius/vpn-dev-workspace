# Insira suas "Service Credentials" da NordVPN aqui (não o email/senha normais)
# Obtido em: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
NORDVPN_USER=cole_seu_usuario_de_servico_aqui
NORDVPN_PASSWORD=cole_sua_senha_de_servico_aqui

# País do servidor VPN (ex: United States, Brazil, Switzerland)
VPN_COUNTRY=United States

# Gere com: docker run --rm qmcgaw/gluetun:v3.40.0 genkey
GLUETUN_API_KEY=gere_uma_chave_diferente_para_este_ambiente

# Opcional: altere para 0.0.0.0 somente se aceitar expor as portas de desenvolvimento na rede.
HOST_BIND_ADDRESS=127.0.0.1
