# O perfil usa arquivos locais de segredo, não valores de credencial no Compose.
# Crie esses arquivos fora do Git e informe seus caminhos absolutos ou relativos.
# Para carregá-los, inicie sempre com ./scripts/vpn-switch <perfil>. O comando
# docker compose up, sem o arquivo de perfil do provedor, não recebe credenciais.
GLUETUN_API_KEY_FILE=.secrets/gluetun_api_key
# Fallbacks para perfis personalizados; perfis conhecidos definem seus próprios valores.
VPN_SERVICE_PROVIDER=nordvpn
VPN_TYPE=openvpn
# Definido pela imagem local do Gluetun; altere só se a imagem suportar outro serviço.
PUBLICIP_API=ifconfigco
NORDVPN_USER_FILE=.secrets/nordvpn_user
NORDVPN_PASSWORD_FILE=.secrets/nordvpn_password
NORDVPN_WIREGUARD_PRIVATE_KEY_FILE=.secrets/nordvpn_wireguard_private_key
PROTONVPN_USER_FILE=.secrets/protonvpn_user
PROTONVPN_PASSWORD_FILE=.secrets/protonvpn_password
PROTONVPN_WIREGUARD_PRIVATE_KEY_FILE=.secrets/protonvpn_wireguard_private_key
SURFSHARK_USER_FILE=.secrets/surfshark_user
SURFSHARK_PASSWORD_FILE=.secrets/surfshark_password
MULLVAD_WIREGUARD_PRIVATE_KEY_FILE=.secrets/mullvad_wireguard_private_key

# País(es) do servidor VPN. Aceita lista separada por vírgula
# (ex: Brazil,Argentina,Chile,United States). Para rotacionar entre países,
# deixe VPN_SERVER_HOSTNAMES vazio: hostnames têm precedência sobre países.
VPN_COUNTRY=United States

# Gere com: docker run --rm qmcgaw/gluetun:v3.41.3 genkey

# A exposição padrão é somente local. Para acesso pela rede local, informe o IP
# específico da interface LAN (por exemplo, 192.168.1.20), nunca 0.0.0.0.
# Com bind em LAN, o vpn-switch exige OPENCODE_GUI_PASSWORD_FILE (o painel web
# do OpenCode fica exposto na faixa publicada; ver seção do painel abaixo).
HOST_BIND_ADDRESS=127.0.0.1

# Faixa TCP publicada pelo Gluetun (padrão estreito: 11 portas, 10000-10010;
# 10001 = painel OpenCode, 10002 = proxy HTTP). Amplie só se precisar de mais
# portas — cada porta extra é superfície de rede publicada.
VPN_PORT_RANGE=10000-10010
VPN_CONTROL_LOCK_DIR=.vpn-control-lock

# Porta de controle do Gluetun publicada no HOST (default 127.0.0.1:18000).
# Os scripts no host (vpn-check/vpn-status/vpn-top/vpn-server-rotate/vpn-reconnect)
# falam com a API por aqui; dentro dos containers a API continua em 127.0.0.1:8000.
# Mantenha fora de VPN_PORT_RANGE. A API continua protegida por API key.
VPN_CONTROL_PORT=18000
VPN_CONTROL_BIND=127.0.0.1

# Manutenção autorizada da conexão VPN e nova tentativa quando não houver IP público.
VPN_RECONNECT_INTERVAL_SECONDS=3600
VPN_RECONNECT_RETRY_SECONDS=30

# Rotação automática de servidor (opt-in; desligada por padrão). Quando ativada,
# o serviço vpn-auto-reconnect troca de servidor após falhas consecutivas.
VPN_ROTATE_SERVERS=false
# Lista opcional de hostnames válidos para ciclar (separados por vírgula).
# Sem lista, o Gluetun re-seleciona um servidor aleatório no país configurado.
# VPN_SERVER_HOSTNAMES=server1.nordvpn.com,server2.nordvpn.com
# Rotação de servidor atende falhas reais de conectividade/privacidade. Desde
# out/2026 NÃO renova a franquia gratuita do Zen (cota por conta/dispositivo:
# host e IPs de datacenter recebem o mesmo Retry-After). Não altera limites de
# uso de provedores.
# Falhas consecutivas antes de trocar de servidor.
VPN_RECONNECT_ATTEMPTS_BEFORE_ROTATE=3
VPN_IP_ATTEMPTS=30
VPN_IP_DELAY_SECONDS=5
# Espera pela confirmação de status=stopped no Gluetun antes do religamento.
VPN_STOP_ATTEMPTS=15
VPN_STOP_DELAY_SECONDS=1
# Estado do auto-reconnect; por padrão em XDG_STATE_HOME/vpn-dev-workspace.
# VPN_AUTO_RECONNECT_STATE_DIR=/var/lib/vpn-control/auto-reconnect
# Rotação periódica de servidor (privacidade), em segundos; 0 = desligada.
# VPN_ROTATE_INTERVAL_SECONDS=86400
# Estado compartilhado da rotação; em Compose usa o volume vpn_control_state
# (/var/lib/vpn-control). No host, o fallback é <repo>/.vpn-control-state/.
# VPN_ROTATE_STATE_FILE=/var/lib/vpn-control/vpn-rotate.index
# Protocolo OpenVPN dos perfis *-openvpn (udp ou tcp). Padrão: udp.
# OPENVPN_PROTOCOL=udp
# Porta OpenVPN customizada (opcional). Na NordVPN, conexões TCP exigem portas 1231-1234
# pois a porta padrão 443 TCP não é mais aceita pelo provedor (gera TCP Reset).
# OPENVPN_ENDPOINT_PORT=1231

# Opcional: caminho absoluto da home do host montada integralmente no terminal.
# O padrão é a home do usuário que executa o Compose. Use-o apenas para outra home
# do mesmo usuário; o terminal recebe leitura e escrita em todo esse diretório.
# HOST_HOME_DIR=/home/desenvolvedor
# Trava a home como somente-leitura (rw|ro; default rw por compat).
# HOST_HOME_MODE=rw
# No modo Windows (vpn.ps1 + compose.windows.yml), HOST_HOME_DIR aponta a pasta
# do usuario: ela e montada inteira em /mnt/host-home e o vpn-home-link cria
# symlinks para os itens de WINDOWS_HOME_LINKS. Sem valor explicito, o vpn.ps1
# usa %USERPROFILE%. A pasta precisa estar no File Sharing do Docker Desktop.
#
# WINDOWS_HOME_LINKS: itens (relativos a home) que o vpn-home-link conecta,
# separados por espaco. Default cobre configs portaveis + ferramentas.
# WINDOWS_HOME_LINKS=.opencode/skills .config/opencode/opencode.json .config/opencode/cli.json .config/opencode/tui.json .config/opencode/package.json .local/share/opencode/auth.json .gitconfig .npmrc .orquestrador-maestro .codex/skills AGENTS.md
#
# WINDOWS_OPENCODE_FULL_LINKS=true (padrao) linka tambem todas as entradas
# visiveis de ~/.config/opencode do host (agents, commands, plugins, skills,
# hooks, ...), exceto node_modules (instalado no container) e backups.
# WINDOWS_OPENCODE_FULL_LINKS=true
#
# Sessoes do OpenCode (.local/share/opencode) NAO sao linkadas (SQLite WAL nao
# funciona sobre o File Sharing); o vpn.ps1 sincroniza por snapshot no
# start/stop via .vpn/sync (gitignored).
#
# XKIRO_API_KEY_FILE: arquivo com a chave do provider xKiro (gateway que
# repassa modelos free para o Console). O host tem XKIRO_API_KEY no ambiente;
# dentro do container a chave chega por este arquivo (o vpn-opencode-wrapper
# exporta antes de abrir o OpenCode). Sem valor, nada e montado (/dev/null).
# XKIRO_API_KEY_FILE=.secrets/xkiro_api_key
# Opcional: caminho absoluto do workspace. Por padrão, /projetos.
# No Windows (compose.windows.yml) o default e a raiz do repositorio e a pasta
# escolhida vira /workspace; a mesma variavel WORKSPACE_DIR vale nos dois sistemas.
# WORKSPACE_DIR=.

# Opcional para perfis customizados:
# CUSTOM_OPENVPN_CONFIG_FILE=.secrets/provider.ovpn
# CUSTOM_OPENVPN_USER_FILE=.secrets/custom_user
# CUSTOM_OPENVPN_PASSWORD_FILE=.secrets/custom_password
# CUSTOM_WIREGUARD_CONFIG_FILE=.secrets/wg0.conf

# --- Acesso à rede interna do host (opt-in) ---
# Sub-redes permitidas fora do túnel, separadas por vírgula (ex: LAN do host).
# Sem valor, o vpn-switch injeta a sub-rede da interface padrão do host.
# Inclua também a sub-rede do DNS interno quando INTERNAL_DNS apontar fora da LAN.
# Não inclua a faixa privada do túnel.
# FIREWALL_SUBNETS=192.168.240.0/24,10.0.0.0/24
#
# DNS interno da LAN (ex: "192.168.240.1:53"): quando definido, o vpn-switch ativa
# o modo plain do Gluetun e ele passa a resolver TUDO (público + interno) por
# esse upstream em texto puro.
# IMPORTANTE: deixe INTERNAL_DNS_RESOLVERS vazio nesse modo, senão as consultas
# são divididas entre upstreams e nomes internos podem falhar aleatoriamente.
# INTERNAL_DNS=192.168.240.1:53
# INTERNAL_DNS_RESOLVERS=cloudflare
# Hostnames internos liberados da proteção contra rebinding. Sem curingas:
# o Gluetun rejeita curingas; liste os nomes explícitos.
# INTERNAL_DNS_EXEMPT_HOSTNAMES=dev.go.internal.example,dev.mt.internal.example
# Hosts locais que só existem no /etc/hosts do host (ex: gitlab.internal.example).
# O vpn-switch gera um snippet e injeta no /etc/hosts do terminal pós-up;
# o vpn-check valida cada nome=ip. Alcance real ainda exige FIREWALL_SUBNETS
# (acima). Recriar o ambiente perde as entradas — sempre suba por vpn-switch.
# LOCAL_HOSTS=gitlab.internal.example=192.168.240.10,registry.internal.example=192.168.240.11
# Host interno opcional testado pelo vpn-check quando configurado.
# INTERNAL_TEST_HOST=internal-server.example
# Porta TCP opcional para teste real de alcance (ex: 80/443). Sem ela, o
# vpn-check valida apenas que o nome resolve.
# INTERNAL_TEST_PORT=80

# --- Paridade com a home do host (opt-in) ---
# UID/GID usados na imagem do terminal (padrão 1000 quando não definidos).
# HOST_UID=1000
# HOST_GID=1000
# Agente SSH do host (caminho absoluto do socket, ex. /run/user/1000/keyring/ssh).
# SSH_AUTH_SOCK=/run/user/1000/keyring/ssh
# Sessão do usuário do host (keyring/dbus), mesma do SSH_AUTH_SOCK.
# RUN_USER_DIR=/run/user/1000

# --- Proxy HTTP pela VPN (opt-in) ---
# Com VPN_HTTP_PROXY=on, o Gluetun expõe proxy em VPN_HTTP_PROXY_PORT
# (default 10002, dentro da faixa publicada — sem entrada nova em ports).
# Uso no host/terminal: export http_proxy=http://127.0.0.1:10002
# https_proxy=http://127.0.0.1:10002
# Preferir FILE a valor direto: senha em env vaza em docker inspect.
# VPN_HTTP_PROXY=on
# VPN_HTTP_PROXY_PORT=10002
# VPN_HTTP_PROXY_STEALTH=on
# VPN_HTTP_PROXY_USER=
# VPN_HTTP_PROXY_PASSWORD não é aceito; use arquivo para evitar segredo no ambiente.
# Caminho do arquivo com a senha (ex: .secrets/httpproxy_password, modo 0600).
# VPN_HTTP_PROXY_PASSWORD_FILE=.secrets/http_proxy_password

# --- Painel web/serve do OpenCode pela VPN (opt-in) ---
# Porta publicada na faixa do Gluetun; acesso em http://127.0.0.1:<porta>.
OPENCODE_SERVER_USER=opencode
# A senha é lida de arquivo, montado como segredo dentro dos containers.
OPENCODE_GUI_PASSWORD_FILE=.secrets/opencode_gui_password
# OPENCODE_SERVER_PASSWORD não é aceito como valor direto; use o arquivo acima.
# OPENCODE_GUI_PORT=10001
# Arquivo com a senha do painel (basic auth, usuário "opencode"). OBRIGATÓRIO
# quando HOST_BIND_ADDRESS aponta para a LAN (o vpn-switch/vpn.ps1 recusam
# subir sem senha); com bind local, sem arquivo o painel abre sem senha.
# Sonda observacional (opt-in; desligada por padrão). O `check` distingue
# ok|down|quota, mas não decide sozinho se deve rotacionar a VPN.
# OPENCODE_AUTOCHECK=false
# --- Recovery de tunnel após eventos do provider ---
# HTTP 429 estruturado reinicia o perfil atual, mesmo se Gluetun disser healthy.
# Outros limites só reconectam quando o Gluetun confirma status=stopped.
# Nenhum evento troca modelo nem repete a solicitação.
# OPENCODE_NETWORK_RECOVERY_COOLDOWN_SECONDS=300
# OPENCODE_NETWORK_RECOVERY_TIMEOUT_SECONDS=300
# Piso entre restarts forçados (HTTP 429): o cooldown normal não bloqueia 429,
# mas 429 sustentado em várias sessões não pode virar loop de restarts.
# OPENCODE_NETWORK_RECOVERY_FORCE_MIN_INTERVAL_SECONDS=60
# O cooldown normal não bloqueia HTTP 429; a mesma sessão+classe é deduplicada.
# OPENCODE_QUOTA_NOTIFY_TTL_SECONDS=300
# Caminho do helper (default do container; só mude em testes).
# OPENCODE_NETWORK_RECOVER_BIN=/usr/local/bin/opencode-network-recover
# Compatibilidade com configurações antigas de `watch`; o supervisor novo usa
# OPENCODE_SUPERVISOR_* abaixo e estes valores servem apenas como fallback.
# OPENCODE_WATCH_INTERVAL=10
# OPENCODE_RESTART_MAX=3
# OPENCODE_WATCH_MODE=serve
# Linhas de log usadas pelo `check`; padrões sobrescrevíveis.
# OPENCODE_CHECK_LOG_LINES=200
# OPENCODE_QUOTA_PATTERNS=quota|billing|insufficient|exceeded|credit.*exhaust|exhaust.*credit|quota.*exceed|exceed.*quota|payment required|out of credit|no credit

# Supervisor persistente do OpenCode (opt-in via: vpn-opencode supervise).
# Supervisor recupera somente desconexões reais de rede/VPN ou túnel unhealthy.
# O supervisor não altera a VPN por eventos de quota; a TUI pode fazê-lo via helper.
# OPENCODE_SUPERVISOR_MODE=serve
# OPENCODE_SUPERVISOR_INTERVAL_SECONDS=10
# OPENCODE_RECOVERY_COOLDOWN_SECONDS=30
# OPENCODE_RECOVERY_WINDOW_SECONDS=900
# OPENCODE_RECOVERY_MAX_ROTATIONS=3
# OPENCODE_READY_ATTEMPTS=30
# OPENCODE_READY_DELAY_SECONDS=2
# Aguarda o túnel ficar saudável após uma recuperação de conectividade.
# OPENCODE_VPN_READY_ATTEMPTS=30
# OPENCODE_VPN_READY_DELAY_SECONDS=2
# Guarda o ID da sessão mais recente, confirma sua disponibilidade e informa o
# comando para retomada manual após recuperação de conectividade.
# OPENCODE_SUPERVISOR_SESSION_FILE=
# Padrões abaixo servem apenas à classificação observacional de `vpn-opencode check`;
# não acionam recuperação VPN. Plugins não classificam texto nem logs.
# OPENCODE_FREE_TIER_LIMIT_PATTERNS=freeusagelimiterror|free[ _-]?tier[ _-]?limit|free limit reached|free usage limit reached|free usage exceeded.*subscribe to go|subscribe to opencode go|used today.?s free messages|provider\.free-limit
# OPENCODE_ACCOUNT_LIMIT_PATTERNS=account_rate_limit|go limit reached|weekly usage limit reached|monthly usage limit reached|usage limit reached.*reset
# OPENCODE_CREDIT_LIMIT_PATTERNS=creditlimitexceeded|insufficientfunds|credit_limit|budget_exceeded|account_budget_exceeded|limitexceeded|payment_required|out_of_credit|no_credit
# OPENCODE_ZEN_PATTERNS compõe as três listas acima; sobrescreva só em casos específicos.
# OPENCODE_ZEN_PATTERNS=
# OPENCODE_RATE_LIMIT_PATTERNS=provider rate limit exceeded|too many requests|too_many_requests|http[^0-9]*429|status[^0-9]*429|rate[ -]?limit exceeded
# Plugins v1/v2 usam eventos estruturados para exibir estado do provider e
# impedir retry automático em limites reconhecidos. Quota/autenticação não
# alteram a VPN; rate_limit/HTTP 429 estruturado reinicia o perfil atual. Nenhum
# evento troca modelo ou repete um turno.
# `vpn-opencode check` continua observacional; seus padrões abaixo só classificam
# status e nunca acionam uma recuperação.
# OPENCODE_DISCONNECT_PATTERNS=network connection lost|connection lost|connection reset|econnreset|etimedout|network error|network request failed|fetch failed|socket hang up|provider.*disconnected|upstream.*disconnected|stream.*disconnected
# Launchers opencode1/opencode2 executam no container; para rodar no HOST,
# fora do túnel e sem integração VPN, use explicitamente:
#   OPENCODE_ALLOW_HOST=1 opencode1|opencode2 [argumentos]


# --- Estado do OpenCode dentro do container (isolamento host x container) ---
# O service.json do OpenCode é um singleton por usuário. Como o container monta
# a home do host no mesmo caminho, host e container disputavam o registro e o
# servidor reiniciava em loop. Só o estado é isolado; o banco/sessões/auth
# continuam compartilhados via XDG_DATA_HOME (~/.local/share).
# OPENCODE_CONTAINER_STATE_HOME=/home/desenvolvedor/.local/state-vpn

# --- Modo Windows (preenchido pelo scripts/vpn.ps1; não edite) ---
# O PowerShell define estes valores temporários ao iniciar a ponte SSH e usa
# o override compose.windows.yml. O workspace Windows vira /workspace e a
# home Linux persistente usa o volume Docker vpn_windows_home.
# WINDOWS_WORKSPACE_DIR=C:\caminho\para\vpn-dev-workspace
# WINDOWS_SSH_BRIDGE_HOST=host.docker.internal
# WINDOWS_SSH_BRIDGE_PORT=
# WINDOWS_SSH_BRIDGE_TOKEN=

# Control Plane local (opt-in; use perfil Compose 'control' apos subir a VPN).
# A faixa VPN_PORT_RANGE precisa conter CONTROL_UI_PORT; o padrao 10000-10010 contem 10003.
CONTROL_UI_PORT=10003
# Crie com: mkdir -p .secrets && chmod 700 .secrets && umask 077 && ...
# Obrigatorio ao iniciar a UI; pelo menos 16 caracteres; nao versionar o conteudo.
CONTROL_UI_PASSWORD_FILE=.secrets/control_ui_password
VPN_CONTROL_INTERVAL_SECONDS=30

# Managed OpenCode GUI/serve/supervisor rejects versions other than the tested
# baseline; enable canary only in an isolated environment.
OPENCODE_V2_EXPECTED_VERSION=2.3.2
OPENCODE_V2_ALLOW_UNVERIFIED=false
