# O perfil usa arquivos locais de segredo, não valores de credencial no Compose.
# Crie esses arquivos fora do Git e informe seus caminhos absolutos ou relativos.
# Para carregá-los, inicie sempre com ./scripts/vpn-switch <perfil>. O comando
# docker compose up, sem o arquivo de perfil do provedor, não recebe credenciais.
GLUETUN_API_KEY_FILE=.secrets/gluetun_api_key
NORDVPN_USER_FILE=.secrets/nordvpn_user
NORDVPN_PASSWORD_FILE=.secrets/nordvpn_password
NORDVPN_WIREGUARD_PRIVATE_KEY_FILE=.secrets/nordvpn_wireguard_private_key
PROTONVPN_USER_FILE=.secrets/protonvpn_user
PROTONVPN_PASSWORD_FILE=.secrets/protonvpn_password
PROTONVPN_WIREGUARD_PRIVATE_KEY_FILE=.secrets/protonvpn_wireguard_private_key
SURFSHARK_USER_FILE=.secrets/surfshark_user
SURFSHARK_PASSWORD_FILE=.secrets/surfshark_password
MULLVAD_WIREGUARD_PRIVATE_KEY_FILE=.secrets/mullvad_wireguard_private_key

# País do servidor VPN (ex: United States, Brazil, Switzerland)
VPN_COUNTRY=United States

# Gere com: docker run --rm qmcgaw/gluetun:v3.40.0 genkey

# A exposição padrão é somente local. Para acesso pela rede local, informe o IP
# específico da interface LAN (por exemplo, 192.168.1.20), nunca 0.0.0.0.
HOST_BIND_ADDRESS=127.0.0.1

# Faixa TCP publicada pelo Gluetun. Configure as aplicações para escutar nela.
VPN_PORT_RANGE=10000-10100

# Manutenção autorizada da conexão VPN e nova tentativa quando não houver IP público.
VPN_RECONNECT_INTERVAL_SECONDS=3600
VPN_RECONNECT_RETRY_SECONDS=30

# Opcional: caminho absoluto da home do host montada integralmente no terminal.
# O padrão é a home do usuário que executa o Compose. Use-o apenas para outra home
# do mesmo usuário; o terminal recebe leitura e escrita em todo esse diretório.
# HOST_HOME_DIR=/home/desenvolvedor
# Opcional: caminho absoluto do workspace. Por padrão, /projetos.
# WORKSPACE_DIR=.

# Opcional para perfis customizados:
# CUSTOM_OPENVPN_CONFIG_FILE=.secrets/provider.ovpn
# CUSTOM_OPENVPN_USER_FILE=.secrets/custom_user
# CUSTOM_OPENVPN_PASSWORD_FILE=.secrets/custom_password
# CUSTOM_WIREGUARD_CONFIG_FILE=.secrets/wg0.conf
